{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🤖 Start Trading Bot (Full Logs)",
            "type": "debugpy",
            "request": "launch",
            "module": "infrastructure.scheduler_runner",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "PYTHONIOENCODING": "utf-8"
            },
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/venv/Scripts/python.exe"
        },
        {
            "name": "🧪 Run Full Bot Backtest",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/full_bot_backtest.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "PYTHONIOENCODING": "utf-8"
            },
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/venv/Scripts/python.exe"
        },
        {
            "name": "🔬 Debug Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "PYTHONIOENCODING": "utf-8"
            },
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/venv/Scripts/python.exe"
        },
        {
            "name": "📊 Train ML Model",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/ml/train_model.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "PYTHONIOENCODING": "utf-8"
            },
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/venv/Scripts/python.exe"
        }
    ]
}

