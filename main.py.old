"""
Main orchestrator for OKX trading bot.
Coordinates all components and manages the main trading loop.
"""

import asyncio
import signal
import sys
import time
from typing import Any

from dotenv import find_dotenv, load_dotenv

load_dotenv(find_dotenv(), override=False)
from datetime import datetime

from loguru import logger

from bandit import trading_bandit

# Import bot components from Clean Architecture
from configs.policy import load_policy
from infrastructure.scheduler import Scheduler
from application.risk_service import RiskService
from application.trade_service import TradeService
from application.portfolio_service import PortfolioService
from adapters.exchange_okx_ccxt import OKXExchangeAdapter
from adapters.exchange_okx_rest import OKXRESTAdapter
from telegram_bot.bot import TelegramBot
from domain.models import TradingConfig

# Initialize Clean Architecture components
scheduler = Scheduler()
risk_service = RiskService()
portfolio_service = PortfolioService()
okx_ccxt = OKXExchangeAdapter()
okx_rest = OKXRESTAdapter()
telegram_bot = TelegramBot()
trade_service = TradeService(okx_ccxt, load_policy(), risk_service)


class TradingBot:
    """Main trading bot orchestrator."""

    def __init__(self):
        self.running = False
        # Load configuration from Clean Architecture
        self.policy = load_policy()
        self.symbols = self.policy.get('symbols', ['BTC-USDT', 'ETH-USDT'])  # Default symbols
        self.timeframe = self.policy.get('default_timeframe', '1h')
        self.analysis_interval = 300  # 5 minutes
        self.position_update_interval = 60  # 1 minute

        # Trading state
        self.last_analysis = {}
        self.active_trades = {}
        self.daily_stats = {}

        # Performance tracking
        self.start_time = datetime.now()
        self.total_signals = 0
        self.successful_trades = 0

        # Graceful shutdown
        self.shutdown_event = asyncio.Event()

        # Initialize Clean Architecture components
        self.risk_service = risk_service
        self.trade_service = trade_service
        self.portfolio_service = portfolio_service
        self.okx_ccxt = okx_ccxt
        self.okx_rest = okx_rest
        self.telegram_bot = telegram_bot

        # Initialize scheduler
        self._setup_scheduler()

        logger.info("Trading bot initialized with Clean Architecture system")

    async def start(self):
        """Start the trading bot."""
        try:
            logger.info("Starting OKX Trading Bot...")

            # Test connections
            if not await self._test_connections():
                logger.error("Failed to establish connections")
                return False

            # Initialize components
            await self._initialize_components()

            # Set up signal handlers
            self._setup_signal_handlers()

            # Start main loop
            self.running = True
            logger.info("Trading bot started successfully")

            # Send startup notification
            await self.telegram_bot.send_notification(
                "Bot Started",
                f"OKX Trading Bot is now running\n"
                f"Mode: {'🟢 LIVE' if not self.policy.get('dry_run', True) else '🟡 DRY RUN'}\n"
                f"Paper Trading: {'Yes' if self.policy.get('paper_trading', True) else 'No'}\n"
                f"Symbols: {len(self.symbols)} coins\n"
                f"Monitoring: {', '.join(self.symbols[:5])}{'...' if len(self.symbols) > 5 else ''}",
                "success"
            )

            # Start scheduler
            await scheduler.start()

            # Start main trading loop
            await self._main_loop()

        except Exception as e:
            logger.error(f"Failed to start trading bot: {e}")
            await self.telegram_bot.send_notification("Startup Failed", str(e), "error")
            return False

        return True

    async def stop(self):
        """Stop the trading bot gracefully."""
        logger.info("Stopping trading bot...")
        self.running = False
        self.shutdown_event.set()

        # Close all positions if in live mode
        if not self.policy.get('dry_run', True):
            await self.risk_service.close_all_positions("bot_shutdown")

        # Send shutdown notification
        await self.telegram_bot.send_notification(
            "Bot Stopped",
            "OKX Trading Bot has been stopped",
            "warning"
        )

        # Close connections
        await self._cleanup()

        logger.info("Trading bot stopped")

    async def _test_connections(self) -> bool:
        """Test all external connections."""
        try:
            # Test OKX connection
            if not await self.okx_ccxt.test_connection():
                logger.error("OKX connection test failed")
                return False

            # Test Telegram connection
            await self.telegram_bot.send_message("🔄 Testing Telegram connection...")

            logger.info("All connections tested successfully")
            return True

        except Exception as e:
            logger.error(f"Connection test failed: {e}")
            return False

    async def _initialize_components(self):
        """Initialize all bot components."""
        try:
            # Initialize Telegram client
            try:
                await self.telegram_bot.initialize()
                logger.info("Telegram client initialized successfully")
            except Exception as e:
                logger.warning(f"Failed to initialize Telegram client: {e}")

            # Create default bandit arms for each symbol
            for symbol in self.symbols:
                trading_bandit.create_default_arms(symbol)

            # Load existing state
            await self._load_bot_state()

            # Reset daily metrics if it's a new day
            await self._check_daily_reset()

            logger.info("All components initialized")

        except Exception as e:
            logger.error(f"Component initialization failed: {e}")
            raise

    async def _load_bot_state(self):
        """Load bot state from persistent storage."""
        try:
            # Load portfolio
            portfolio = await state_store.get_portfolio()
            if not portfolio:
                # Initialize default portfolio
                default_portfolio = {
                    "total_balance": 0.0,
                    "total_pnl": 0.0,
                    "total_pnl_percent": 0.0,
                    "daily_pnl": 0.0,
                    "daily_pnl_percent": 0.0,
                    "margin_ratio": 0.0,
                    "active_positions": 0,
                    "last_updated": datetime.now().isoformat()
                }
                await state_store.save_portfolio(default_portfolio)

            # Load positions
            positions = await state_store.get_positions()
            if positions:
                logger.info(f"Loaded {len(positions)} existing positions")

            # Load goals
            goals = await state_store.get_goals()
            if goals:
                logger.info(f"Loaded trading goals: {goals.get('growth_goal', 0)}% growth, {goals.get('max_drawdown', 0)}% max DD")

        except Exception as e:
            logger.error(f"Failed to load bot state: {e}")

    async def _check_daily_reset(self):
        """Check if daily metrics should be reset."""
        try:
            portfolio = await state_store.get_portfolio()
            if portfolio and portfolio.get("last_updated"):
                last_updated = datetime.fromisoformat(portfolio["last_updated"])
                if last_updated.date() < datetime.now().date():
                    logger.info("New day detected, resetting daily metrics")
                    await self.risk_service.reset_daily_metrics()

                    # Send daily reset notification
                    await self.telegram_bot.send_notification(
                        "Daily Reset",
                        "Daily trading metrics have been reset",
                        "info"
                    )

        except Exception as e:
            logger.error(f"Daily reset check failed: {e}")

    def _setup_signal_handlers(self):
        """Set up signal handlers for graceful shutdown."""
        def signal_handler(signum, frame):
            logger.info(f"Received signal {signum}, initiating shutdown...")
            asyncio.create_task(self.stop())

        signal.signal(signal.SIGINT, signal_handler)
        signal.signal(signal.SIGTERM, signal_handler)

    async def _main_loop(self):
        """Main trading loop."""
        logger.info("Entering main trading loop")

        # Start background tasks
        tasks = [
            asyncio.create_task(self._analysis_loop()),
            asyncio.create_task(self._position_monitoring_loop()),
            asyncio.create_task(self._portfolio_update_loop()),
            asyncio.create_task(self._risk_monitoring_loop())
        ]

        try:
            # Wait for shutdown signal
            await self.shutdown_event.wait()

        except Exception as e:
            logger.error(f"Main loop error: {e}")
            await self.telegram_bot.send_notification("Main Loop Error", str(e), "error")

        finally:
            # Cancel all background tasks
            for task in tasks:
                task.cancel()

            # Wait for tasks to complete
            await asyncio.gather(*tasks, return_exceptions=True)

    async def _analysis_loop(self):
        """Main analysis loop for generating trading signals."""
        while self.running and not self.shutdown_event.is_set():
            try:
                analyzed_count = 0
                for symbol in self.symbols:
                    if not self.running:
                        break

                    # Check if analysis is needed
                    if self._should_analyze_symbol(symbol):
                        await self._analyze_symbol(symbol)
                        analyzed_count += 1

                    # Small delay between symbols
                    await asyncio.sleep(1)



                # Wait for next analysis cycle
                await asyncio.sleep(self.analysis_interval)

            except Exception as e:
                logger.error(f"Analysis loop error: {e}")
                await asyncio.sleep(10)  # Wait before retrying

    async def _position_monitoring_loop(self):
        """Monitor active positions and update PnL."""
        while self.running and not self.shutdown_event.is_set():
            try:
                # Get current positions
                positions = await state_store.get_positions()

                for position in positions:
                    symbol = position.get("symbol")
                    if symbol:
                        # Get current price
                        current_price = await self.okx_ccxt.get_mark_price(symbol)
                        if current_price > 0:
                            # Update position PnL
                            await self.risk_service.update_position_pnl(symbol, current_price)

                            # Check if position was closed and record outcome
                            await self._check_position_closure(position, current_price)

                # Wait for next update
                await asyncio.sleep(self.position_update_interval)

            except Exception as e:
                logger.error(f"Position monitoring error: {e}")
                await asyncio.sleep(10)

    async def _portfolio_update_loop(self):
        """Update portfolio information periodically."""
        while self.running and not self.shutdown_event.is_set():
            try:
                # Update portfolio from exchange
                await self._update_portfolio()

                # Wait for next update (every 5 minutes)
                await asyncio.sleep(300)

            except Exception as e:
                logger.error(f"Portfolio update error: {e}")
                await asyncio.sleep(60)

    async def _risk_monitoring_loop(self):
        """Monitor risk metrics and send alerts."""
        while self.running and not self.shutdown_event.is_set():
            try:
                # Check risk metrics
                risk_summary = await self.risk_service.get_risk_summary()

                # Send alerts for critical conditions
                if risk_summary.get("trading_paused", False):
                    await self.telegram_bot.send_risk_alert(
                        "Trading Paused",
                        "Trading has been paused due to risk management",
                        "warning"
                    )

                if risk_summary.get("daily_loss_used", 0) > risk_summary.get("daily_loss_cap", 100) * 0.8:
                    await self.telegram_bot.send_risk_alert(
                        "Daily Loss Warning",
                        f"Daily loss usage: {risk_summary.get('daily_loss_used', 0):.2f}% (Cap: {risk_summary.get('daily_loss_cap', 100):.2f}%)",
                        "warning"
                    )

                # Wait for next check (every 2 minutes)
                await asyncio.sleep(120)

            except Exception as e:
                logger.error(f"Risk monitoring error: {e}")
                await asyncio.sleep(60)

    def _should_analyze_symbol(self, symbol: str) -> bool:
        """Check if symbol should be analyzed."""
        now = datetime.now()
        last_analysis = self.last_analysis.get(symbol)

        if not last_analysis:
            return True

        time_since_last = (now - last_analysis).total_seconds()
        return time_since_last >= self.analysis_interval

    async def _get_portfolio_state(self) -> dict[str, Any]:
        """Get current portfolio state for risk scoring."""
        try:
            # Get basic portfolio information
            portfolio_state = {
                "total_risk_pct": 0.0,
                "symbol_risk": {},
                "current_drawdown_pct": 0.0,
                "margin_ratio": 0.0,
                "correlations": {}
            }

            # Get account balance
            try:
                balance = await self.okx_ccxt.get_account_balance()
                total_equity = balance.get("total_equity", 10000.0)
                portfolio_state["total_equity"] = total_equity
            except Exception as e:
                logger.warning(f"Failed to get account balance: {e}")
                portfolio_state["total_equity"] = 10000.0

            # Get positions for risk calculation
            try:
                positions = await self.okx_ccxt.fetch_positions()
                if positions:
                    total_notional = sum(float(pos.get("notional", 0)) for pos in positions)
                    portfolio_state["total_risk_pct"] = (total_notional / portfolio_state["total_equity"]) * 100 if portfolio_state["total_equity"] > 0 else 0

                    # Calculate symbol-specific risk
                    for pos in positions:
                        symbol = pos.get("symbol", "")
                        if symbol:
                            notional = float(pos.get("notitions", 0))
                            symbol_risk_pct = (notional / portfolio_state["total_equity"]) * 100 if portfolio_state["total_equity"] > 0 else 0
                            portfolio_state["symbol_risk"][symbol] = symbol_risk_pct
            except Exception as e:
                logger.warning(f"Failed to get positions: {e}")

            # Get risk manager summary
            try:
                risk_summary = risk_manager.get_risk_summary()
                portfolio_state["daily_pnl"] = risk_summary.get("daily_pnl", 0.0)
                portfolio_state["daily_loss_used"] = risk_summary.get("daily_loss_used", 0.0)
                portfolio_state["daily_loss_cap"] = risk_summary.get("daily_loss_cap", 0.0)

                # Calculate drawdown
                if portfolio_state["total_equity"] > 0:
                    portfolio_state["current_drawdown_pct"] = abs(portfolio_state["daily_pnl"] / portfolio_state["total_equity"]) * 100
            except Exception as e:
                logger.warning(f"Failed to get risk summary: {e}")

            return portfolio_state

        except Exception as e:
            logger.error(f"Failed to get portfolio state: {e}")
            return {
                "total_equity": 10000.0,
                "total_risk_pct": 0.0,
                "symbol_risk": {},
                "current_drawdown_pct": 0.0,
                "margin_ratio": 0.0,
                "correlations": {}
            }

    async def _send_composite_analysis_notification(self, symbol: str, composite_signal):
        """Send single consolidated notification with all composite analysis results."""
        try:
            # Only send notifications for trading decisions (LONG/SHORT), not FLAT
            if composite_signal.decision == 'FLAT':
                logger.debug(f"📊 Skipping notification for {symbol}: FLAT decision")
                return

            # Extract scores and details
            ta_score = composite_signal.technical.score
            ml_score = composite_signal.ml.score
            news_score = composite_signal.news.score
            risk_score = composite_signal.risk.score

            # Decision emoji mapping
            decision_emoji = {
                'LONG': '🟢',
                'SHORT': '🔴',
                'FLAT': '⚪'
            }

            # Grade emoji mapping
            grade_emoji = {
                'A+': '🏆',
                'A': '🥇',
                'B': '🥈',
                'C': '🥉',
                'D': '📉'
            }

            # Threshold check
            threshold_met = "✅" if composite_signal.confidence_pct >= 60 else "❌"

            # Create consolidated message with all information
            message = (
                f"📊 <b>COMPOSITE ANALYSIS: {symbol}</b>\n"
                f"{'='*50}\n\n"
                f"🎯 <b>Decision:</b> {composite_signal.decision} {decision_emoji.get(composite_signal.decision, '')}\n"
                f"📊 <b>Final Score:</b> {composite_signal.final_score:.1f}/100 {grade_emoji.get(composite_signal.grade, '📊')} {composite_signal.grade}\n"
                f"💪 <b>Confidence:</b> {composite_signal.confidence_pct:.1f}% {threshold_met}\n\n"
            )

            # Component scores with emojis and thresholds
            message += "📈 <b>COMPONENT SCORES:</b>\n"

            # Technical Analysis
            ta_emoji = "🟢" if ta_score >= 70 else "🟡" if ta_score >= 50 else "🔴"
            ta_threshold = "✅" if ta_score >= 60 else "❌"
            message += f"  {ta_emoji} Technical: {ta_score:.1f}/100 {ta_threshold}\n"

            # ML Score with details
            ml_emoji = "🟢" if ml_score >= 70 else "🟡" if ml_score >= 50 else "🔴"
            ml_threshold = "✅" if ml_score >= 60 else "❌"
            message += f"  🤖 ML: {ml_score:.1f}/100 {ml_threshold}\n"

            # ML Rationale (if available)
            if hasattr(composite_signal.ml, 'rationale') and composite_signal.ml.rationale:
                message += f"     📝 {composite_signal.ml.rationale}\n"

            # News Score
            news_emoji = "🟢" if news_score >= 70 else "🟡" if news_score >= 50 else "🔴"
            news_threshold = "✅" if news_score >= 60 else "❌"
            message += f"  📰 News: {news_score:.1f}/100 {news_threshold}\n"

            # Risk Score with details
            risk_emoji = "🟢" if risk_score >= 80 else "🟡" if risk_score >= 60 else "🔴"
            risk_threshold = "✅" if risk_score >= 70 else "❌"
            message += f"  🛡️ Risk: {risk_score:.1f}/100 {risk_threshold}\n"

            # Risk Level and Penalties (if available)
            if hasattr(composite_signal.risk, 'risk_level') and composite_signal.risk.risk_level:
                message += f"     🚨 Risk Level: {composite_signal.risk.risk_level.upper()}\n"

            if hasattr(composite_signal.risk, 'penalties') and composite_signal.risk.penalties:
                message += f"     ⚠️ Penalties: {', '.join(composite_signal.risk.penalties)}\n"

            message += "\n"

            # Strategy and SL/TP
            strategy = composite_signal.meta.get('strategy', 'mixed')
            strategy_emoji = {
                'trend_following': '📈',
                'mean_reversion': '🔄',
                'breakout': '🚀',
                'mixed': '🎲'
            }

            message += f"{strategy_emoji.get(strategy, '📊')} <b>Strategy:</b> {strategy}\n"

            if 'sl_pct' in composite_signal.meta:
                sl_pct = composite_signal.meta['sl_pct']
                tp_pct = composite_signal.meta['tp_pct']
                message += f"🛑 <b>Stop Loss:</b> {sl_pct}% | 🎯 <b>Take Profit:</b> {tp_pct}%\n"

            # Technical flags
            if hasattr(composite_signal.technical, 'flags') and composite_signal.technical.flags:
                flags = composite_signal.technical.flags
                message += "\n🏁 <b>TECHNICAL FLAGS:</b>\n"
                if 'trend' in flags:
                    trend_emoji = {'up': '📈', 'down': '📉', 'side': '➡️'}
                    message += f"  {trend_emoji.get(flags['trend'], '📊')} Trend: {flags['trend']}\n"
                if 'meanrev' in flags:
                    meanrev_emoji = {'on': '🔄', 'off': '➡️'}
                    message += f"  {meanrev_emoji.get(flags['meanrev'], '📊')} Mean Reversion: {flags['meanrev']}\n"
                if 'breakout' in flags:
                    breakout_emoji = {'on': '🚀', 'off': '➡️'}
                    message += f"  {breakout_emoji.get(flags['breakout'], '📊')} Breakout: {flags['breakout']}\n"
                if 'dir_hint' in flags:
                    dir_emoji = {'LONG': '🟢', 'SHORT': '🔴', 'FLAT': '⚪'}
                    message += f"  🎯 Direction Hint: {flags['dir_hint']} {dir_emoji.get(flags['dir_hint'], '')}\n"

            # Send single consolidated message
            await telegram_client.send_message(message, parse_mode='HTML')

            logger.info(f"✅ Single consolidated analysis notification sent for {symbol}")

        except Exception as e:
            logger.error(f"❌ Consolidated analysis notification failed for {symbol}: {e}")



    async def _analyze_symbol(self, symbol: str):
        """Analyze a single symbol for trading opportunities using composite scoring."""
        try:
            logger.debug(f"Analyzing {symbol} with composite scoring...")

            # Load policy configuration for scoring weights and thresholds
            from policy import load_policy
            policy = load_policy()
            scoring_weights = policy.get('scoring', {}).get('weights', {})
            thresholds = policy.get('thresholds', {})
            timeframes_config = policy.get('timeframes', {})
            fallback_config = policy.get('data_fallback', {})

            # Define timeframes
            timeframes = {
                'trend': timeframes_config.get('trend_filter', '1h'),
                'main': timeframes_config.get('main', '15m'),
                'entry': timeframes_config.get('entry_confirmation', '5m')
            }

            # Use enhanced data manager for OHLCV fetching
            from data_manager import data_manager

            # Get OHLCV bundle with fallback strategies
            ohlcv_bundle_result = await data_manager.get_ohlcv_bundle(
                symbol, timeframes, fallback_config
            )

            # Check if we have enough data for analysis
            if not ohlcv_bundle_result.data or len(ohlcv_bundle_result.data) == 0:
                logger.warning(f"No OHLCV data available for {symbol} - skipping analysis")
                return None

            # Log bundle status
            if ohlcv_bundle_result.degraded_timeframes and len(ohlcv_bundle_result.degraded_timeframes) > 0:
                logger.warning(f"⚠️ {symbol}: Degraded timeframes: {ohlcv_bundle_result.degraded_timeframes}")

            if ohlcv_bundle_result.cache_hits and len(ohlcv_bundle_result.cache_hits) > 0:
                logger.info(f"📦 {symbol}: Using cached data for: {ohlcv_bundle_result.cache_hits}")

            # Extract DataFrame bundle for compatibility
            ohlcv_bundle = ohlcv_bundle_result.data

            # Get portfolio state for risk scoring
            portfolio_state = await self._get_portfolio_state()

            # Import scoring components
            from scoring import (
                CompositeSignal,
                MLBlock,
                NewsBlock,
                RiskBlock,
                TechnicalBlock,
                ml_scorer,
                news_scorer,
                risk_scorer,
                ta_scorer,
            )

            # 1. Technical Analysis Scoring
            main_df = ohlcv_bundle.get('main')
            if main_df is None or main_df.empty:
                main_df = ohlcv_bundle.get('15m')

            if main_df is not None and hasattr(main_df, 'empty') and not main_df.empty:
                ta_score, ta_rationale, ta_flags = ta_scorer.score(main_df, symbol)
                technical_block = TechnicalBlock(
                    score=ta_score,
                    rationale=ta_rationale,
                    flags=ta_flags
                )
            else:
                technical_block = TechnicalBlock(
                    score=50.0,
                    rationale="No technical data available",
                    flags={"dir_hint": "FLAT"}
                )

            # 2. Machine Learning Scoring
            ml_score, ml_rationale, ml_details = ml_scorer.score(symbol, ohlcv_bundle)
            ml_block = MLBlock(
                score=ml_score,
                rationale=ml_rationale,
                details=ml_details
            )

            # 3. News Sentiment Scoring
            news_score, news_categories, news_rationale, volatility_impact = news_scorer.score(symbol)
            news_block = NewsBlock(
                score=news_score,
                categories=news_categories,
                rationale=news_rationale,
                volatility_impact=volatility_impact
            )

            # 4. Risk Management Scoring
            risk_score, risk_details = risk_scorer.score(symbol, portfolio_state)
            risk_block = RiskBlock(
                score=risk_score,
                details=risk_details
            )

            # 5. Create Composite Signal
            composite_signal = CompositeSignal(
                symbol=symbol,
                timestamp=datetime.now(),
                timeframes=timeframes,
                technical=technical_block,
                ml=ml_block,
                news=news_block,
                risk=risk_block
            )

            # 6. Finalize the signal
            direction_hint = technical_block.flags.get("dir_hint", "FLAT")
            composite_signal.finalize(scoring_weights, thresholds, direction_hint)

            # 7. Log comprehensive analysis results
            logger.info(f"📊 Composite Analysis for {symbol}:")
            logger.info(f"   Technical: {technical_block.score:.1f}/100 - {technical_block.rationale}")
            logger.info(f"   ML: {ml_block.score:.1f}/100 - {ml_block.rationale}")
            logger.info(f"   News: {news_block.score:.1f}/100 - {news_block.rationale}")
            logger.info(f"   Risk: {risk_block.score:.1f}/100")
            logger.info(f"   Final Score: {composite_signal.final_score:.1f}/100 ({composite_signal.grade})")
            logger.info(f"   Decision: {composite_signal.decision}")

            # 8. Send notification with composite scores (if notification system supports it)
            try:
                await self._send_composite_analysis_notification(symbol, composite_signal)
            except Exception as e:
                logger.warning(f"Failed to send composite analysis notification: {e}")

            # 9. Store signal for potential use by other systems
            signal_data = {
                "symbol": symbol,
                "timestamp": datetime.now().isoformat(),
                "composite_signal": composite_signal.to_dict(),
                "decision": composite_signal.decision,
                "confidence": composite_signal.confidence_pct,
                "grade": composite_signal.grade,
                "technical_score": technical_block.score,
                "ml_score": ml_block.score,
                "news_score": news_block.score,
                "risk_score": risk_block.score,
                "final_score": composite_signal.final_score
            }

            # Update last analysis time
            self.last_analysis[symbol] = datetime.now()

            # Log the complete signal for debugging
            logger.info(f"📊 Complete Composite Signal for {symbol}: {signal_data}")
            logger.debug(f"Composite analysis completed for {symbol}: {composite_signal.decision}")

            return signal_data

        except Exception as e:
            logger.error(f"Composite symbol analysis failed for {symbol}: {e}")
            return None




    async def _process_trading_signal(self, signal: dict[str, Any]):
        """Process a trading signal and execute if appropriate using new risk management system."""
        try:
            symbol = signal["symbol"]
            decision = signal["decision"]
            confidence = signal["confidence"]

            logger.info(f"Processing signal: {symbol} {decision} (confidence: {confidence:.2f})")

            # Check if we already have a position in this symbol
            existing_position = await self._get_existing_position(symbol)
            if existing_position:
                logger.info(f"Position already exists for {symbol}, skipping signal")
                return

            # Get current open positions for risk evaluation
            open_positions = await self._get_all_open_positions()

            # Get account information for risk calculations
            account_info = await self._get_account_info()
            account_equity = account_info.get("equity", 10000.0)  # Default fallback
            margin_ratio = account_info.get("margin_ratio", 0.0)

            # Evaluate trade opportunity with new risk management system
            should_trade, evaluation_info = self.trade_manager.evaluate_trade_opportunity(
                symbol=symbol,
                signal=signal,
                open_positions=open_positions,
                account_equity=account_equity,
                margin_ratio=margin_ratio
            )

            if not should_trade:
                logger.info(f"Trade blocked by risk management: {evaluation_info.get('block_reason', 'Unknown')}")
                return

            # Send signal notification
            await telegram_client.send_trade_signal(signal)

            # Execute trade using new trade manager
            success, execution_info = self.trade_manager.execute_trade(
                symbol=symbol,
                signal=signal,
                evaluation_info=evaluation_info,
                account_info=account_info
            )

            if success:
                self.total_signals += 1
                logger.info(f"Trade executed successfully: {symbol} {decision}")

                # Record bandit outcome (will be updated when position closes)
                if signal.get("arm_id"):
                    trading_bandit.record_outcome(signal["arm_id"], 0.0)  # Initial neutral reward
            else:
                logger.error(f"Trade execution failed: {execution_info.get('error', 'Unknown error')}")

        except Exception as e:
            logger.error(f"Signal processing failed: {e}")
            await telegram_client.send_notification("Signal Processing Error", str(e), "error")

    async def _get_existing_position(self, symbol: str) -> dict[str, Any] | None:
        """Get existing position for a symbol."""
        try:
            positions = await state_store.get_positions()
            for position in positions:
                if position.get("symbol") == symbol:
                    return position
            return None
        except Exception as e:
            logger.error(f"Failed to get existing position: {e}")
            return None

    async def _get_all_open_positions(self) -> list[dict[str, Any]]:
        """Get all current open positions."""
        try:
            positions = await state_store.get_positions()
            return [pos for pos in positions if pos.get("status") == "open"]
        except Exception as e:
            logger.error(f"Failed to get open positions: {e}")
            return []

    async def _get_account_info(self) -> dict[str, Any]:
        """Get account information from exchange."""
        try:
            # Try to get real account info from OKX
            account_info = await okx_client.get_account_balance()
            if account_info:
                return {
                    "equity": float(account_info.get("totalEq", 10000.0)),
                    "margin_ratio": float(account_info.get("mgnRatio", 0.0))
                }
        except Exception as e:
            logger.warning(f"Failed to get account info: {e}")

        # Fallback to default values
        return {
            "equity": 10000.0,
            "margin_ratio": 0.0
        }

    async def _check_position_closure(self, position: dict[str, Any], current_price: float):
        """Check if a position was closed and record the outcome."""
        try:
            symbol = position.get("symbol")
            position_status = position.get("status")

            # If position is marked as closed, record the outcome
            if position_status == "closed":
                # Extract position details
                side = position.get("side", "LONG").upper()
                open_time = position.get("open_time")
                close_time = position.get("close_time")
                entry_price = position.get("entry_price", 0.0)
                exit_price = position.get("exit_price", current_price)
                stop_loss = position.get("stop_loss", 0.0)
                pnl_usd = position.get("pnl_usd", 0.0)

                # Convert timestamps
                open_ts = int(open_time.timestamp()) if isinstance(open_time, datetime) else int(open_time or 0)
                close_ts = int(close_time.timestamp()) if isinstance(close_time, datetime) else int(close_time or 0)

                # Record trade outcome with new performance tracker
                success = self.trade_manager.record_trade_outcome(
                    symbol=symbol,
                    side=side,
                    open_ts=open_ts,
                    close_ts=close_ts,
                    entry=entry_price,
                    exit=exit_price,
                    stop=stop_loss,
                    pnl_usd=pnl_usd
                )

                if success:
                    logger.info(f"Trade outcome recorded: {symbol} {side} PnL: ${pnl_usd:.2f}")
                    self.successful_trades += 1

        except Exception as e:
            logger.error(f"Failed to check position closure: {e}")

    async def _execute_trade(self, planned_trade) -> bool:
        """Execute a planned trade."""
        try:
            symbol = planned_trade.symbol
            side = planned_trade.side
            size = planned_trade.size
            price = planned_trade.entry_price

            # Place order
            order = await okx_client.place_order(
                symbol=symbol,
                side=side,
                order_type="market",
                size=size,
                price=price
            )

            if order and order.get("status") in ["open", "filled"]:
                # Update risk management
                await risk_manager.on_fill_update(planned_trade, order)

                # Send execution notification
                await telegram_client.send_notification(
                    "Trade Executed",
                    f"{symbol} {side} {size:.4f} @ {price:.8f}",
                    "trade"
                )

                return True
            else:
                logger.error(f"Order placement failed for {symbol}")
                return False

        except Exception as e:
            logger.error(f"Trade execution failed: {e}")
            return False

    async def _update_portfolio(self):
        """Update portfolio information from exchange."""
        try:
            # Fetch balance and positions
            balance = await okx_client.fetch_balance()
            positions = await okx_client.fetch_positions()

            # Calculate portfolio metrics
            total_balance = balance.get("total", {}).get("USDT", 0.0)
            total_pnl = sum(pos.get("unrealized_pnl", 0) for pos in positions)
            total_pnl_percent = (total_pnl / total_balance * 100) if total_balance > 0 else 0

            # Update portfolio
            portfolio = {
                "total_balance": total_balance,
                "total_pnl": total_pnl,
                "total_pnl_percent": total_pnl_percent,
                "daily_pnl": risk_manager.daily_pnl,
                "daily_pnl_percent": (risk_manager.daily_pnl / total_balance * 100) if total_balance > 0 else 0,
                "margin_ratio": 0.0,  # Would calculate from exchange data
                "active_positions": len(positions),
                "last_updated": datetime.now().isoformat()
            }

            await state_store.save_portfolio(portfolio)

            # Update positions
            await state_store.save_positions(positions)

            logger.debug("Portfolio updated successfully")

        except Exception as e:
            logger.error(f"Portfolio update failed: {e}")


    def _setup_scheduler(self):
        """Set up scheduled jobs with enhanced notification system."""
        try:
            # Analysis job - every 5 minutes (now handled by notification manager)
            scheduler.add_job(
                name="analyze_job",
                func=self._run_analysis,
                interval_seconds=300,  # 5 minutes
                description="Run technical analysis on all symbols"
            )

            # News update job - every 30 minutes
            scheduler.add_job(
                name="news_job",
                func=self._update_news,
                interval_seconds=1800,  # 30 minutes
                description="Fetch latest crypto news and update sentiment"
            )

            # Note: 4-hour summary is now handled by the enhanced scheduler
            # in scheduler.py with proper timezone handling

            logger.info("Enhanced scheduler jobs configured")

        except Exception as e:
            logger.error(f"Failed to setup enhanced scheduler: {e}")

    async def _run_analysis(self):
        """Run technical analysis on all symbols."""
        try:
            logger.info("Running scheduled analysis...")

            # Run analysis for all configured symbols
            from config import symbols
            logger.info(f"Starting analysis for {len(symbols)} symbols: {', '.join(symbols)}")

            # Track skipped symbols and reasons
            skipped_symbols = []
            successful_analyses = 0

            # Store analysis results for external access
            self.latest_analysis_results = []

            for symbol in symbols:
                try:
                    # Run technical analysis (symbol will be normalized in OKX client)
                    analysis_result = await self._analyze_symbol(symbol)

                    if analysis_result:
                        successful_analyses += 1

                        # Store analysis result for external access
                        self.latest_analysis_results.append(analysis_result)

                        # Convert composite signal to trade execution format
                        if analysis_result.get('decision') in ['LONG', 'SHORT']:
                            logger.info(f"🔍 DEBUG: Found {analysis_result.get('decision')} decision for {symbol}")

                            # Composite signal format - convert to trade execution format
                            trade_signal = {
                                'should_trade': True,
                                'action': analysis_result['decision'],
                                'confidence': analysis_result['confidence'] / 100.0,  # Convert to 0-1 scale
                                'final_score': analysis_result['final_score'],
                                'technical_score': analysis_result['technical_score'],
                                'ml_score': analysis_result['ml_score'],
                                'news_score': analysis_result['news_score'],
                                'risk_score': analysis_result['risk_score'],
                                'strategy': analysis_result.get('composite_signal', {}).get('meta', {}).get('strategy', 'mixed'),
                                'sl_pct': analysis_result.get('composite_signal', {}).get('meta', {}).get('sl_pct', 2.0),
                                'tp_pct': analysis_result.get('composite_signal', {}).get('meta', {}).get('tp_pct', 4.0)
                            }

                            logger.info(f"🚀 Trade signal detected for {symbol}: {trade_signal['action']} (Score: {trade_signal['final_score']:.1f})")
                            logger.info(f"🔍 DEBUG: About to call _execute_trade_signal for {symbol}")

                            # Execute trade if conditions are met
                            await self._execute_trade_signal(symbol, trade_signal)
                        else:
                            logger.info(f"🔍 DEBUG: No LONG/SHORT decision for {symbol}, decision: {analysis_result.get('decision')}")

                    # Check for legacy strategy format
                    if analysis_result.get('should_trade', False):
                        # Legacy strategy format
                        logger.info(f"Trade signal detected for {symbol}: {analysis_result.get('action', 'UNKNOWN')}")

                        # Execute trade if conditions are met
                        await self._execute_trade_signal(symbol, analysis_result)
                    else:
                        # Symbol was skipped due to insufficient data
                        skipped_symbols.append({
                            'symbol': symbol,
                            'reason': 'insufficient_data',
                            'timestamp': datetime.now().isoformat()
                        })

                except Exception as e:
                    logger.error(f"Failed to analyze {symbol}: {e}")
                    skipped_symbols.append({
                        'symbol': symbol,
                        'reason': 'analysis_error',
                        'error': str(e),
                        'timestamp': datetime.now().isoformat()
                    })

            # Log analysis summary
            logger.info(f"Completed analysis for {len(symbols)} symbols: {successful_analyses} successful, {len(skipped_symbols)} skipped")

            # Send skip notification if enabled
            if skipped_symbols and self.policy.get('data_fallback', {}).get('notify_skips', False):
                await self._send_skip_notification(skipped_symbols)

            # Log data manager metrics
            from data_manager import data_manager
            metrics = data_manager.get_metrics()
            logger.info(f"📊 Data Manager Metrics: {metrics}")

        except Exception as e:
            logger.error(f"Analysis job failed: {e}")

    def get_latest_analysis_results(self) -> list[dict[str, Any]]:
        """Get the latest analysis results for external access."""
        return getattr(self, 'latest_analysis_results', [])

    async def _send_skip_notification(self, skipped_symbols: list[dict[str, Any]]):
        """Send notification about skipped symbols."""
        try:
            if not skipped_symbols:
                return

            # Group by reason
            reason_groups = {}
            for skip in skipped_symbols:
                reason = skip.get('reason', 'unknown')
                if reason not in reason_groups:
                    reason_groups[reason] = []
                reason_groups[reason].append(skip['symbol'])

            # Build notification message
            message = "⏭️ Analysis Skipped Symbols:\n"
            for reason, symbols in reason_groups.items():
                message += f"• {reason}: {', '.join(symbols)}\n"

            # Log skip report instead of sending notification (reduce flood)
            logger.info(f"Analysis skip report: {message}")

        except Exception as e:
            logger.error(f"Failed to process skip report: {e}")

    async def _analyze_symbol_OLD(self, symbol: str):
        """Analyze a single symbol and return trading decision."""
        try:
            logger.info(f"⚠️ OLD SYSTEM: Analyzing {symbol} with legacy strategy")
            # Get OHLCV data for multiple timeframes
            main_tf = self.policy.get('timeframes', {}).get('main', '1h')
            trend_tf = self.policy.get('timeframes', {}).get('trend_filter', '4h')
            entry_tf = self.policy.get('timeframes', {}).get('entry_confirmation', '15m')

            # Fetch data for main timeframe
            df_main = await okx_client.fetch_ohlcv(symbol, main_tf, limit=200)
            if df_main.empty:
                return None

            # Run technical analysis using existing strategy
            from application.strategy_service import strategy_service as trading_strategy
            analysis_result = await trading_strategy.analyze(symbol, df_main)

            # Get news sentiment for this symbol
            if hasattr(self, 'news_client'):
                try:
                    news_client = get_client()
                    news_sentiment = await news_client.get_market_sentiment()
                    if news_sentiment:
                        analysis_result['news_sentiment'] = news_sentiment
                except Exception as e:
                    logger.warning(f"Could not get news sentiment: {e}")

            return analysis_result

        except Exception as e:
            logger.error(f"Symbol analysis failed for {symbol}: {e}")
            return None

    async def _execute_trade_signal(self, symbol: str, signal: dict):
        """Execute a trading signal."""
        try:
            logger.info(f"🔍 DEBUG: _execute_trade_signal called for {symbol} with signal: {signal}")
            action = signal.get('action', '').upper()
            confidence = signal.get('confidence', 0)

            # Check minimum confidence threshold
            min_confidence = self.policy.get('trading', {}).get('min_confidence', 0.50)  # Final score eşiği: 0.50
            if confidence < min_confidence:
                logger.info(f"Signal confidence {confidence} below threshold {min_confidence} for {symbol}")
                return

            # Calculate position size based on account balance percentage (8% risk - increased for OKX minimums)
            account_balance = await self._get_account_balance()
            risk_percentage = self.policy.get('trading', {}).get('risk_per_trade_pct', 8.0) / 100

            # Calculate position size in USDT
            position_size_usdt = account_balance * risk_percentage

            # Calculate dynamic leverage based on volatility and trend strength
            dynamic_leverage = await self._calculate_dynamic_leverage(symbol, signal)

            # Get current price for the symbol
            current_price = await self._get_current_price(symbol)
            if not current_price:
                logger.warning(f"Could not get current price for {symbol}")
                return

            # Calculate position size in coin units
            position_size_coins = position_size_usdt / current_price

            # CRITICAL: Double-check position size doesn't exceed risk limit
            actual_risk_usdt = position_size_coins * current_price
            if actual_risk_usdt > account_balance * 0.25:  # Max 25% as safety (5 positions × 5% each)
                warning_msg = "🚨 KRİTİK HATA! Pozisyon büyüklüğü risk limitini aşıyor!\n"
                warning_msg += f"Symbol: {symbol}\n"
                warning_msg += f"Hesaplanan risk: ${actual_risk_usdt:.2f} USDT\n"
                warning_msg += f"Hesap bakiyesi: ${account_balance:.2f} USDT\n"
                warning_msg += f"Risk yüzdesi: %{(actual_risk_usdt/account_balance)*100:.1f}\n"
                warning_msg += "İşlem iptal edildi!"

                await self._send_telegram_warning(warning_msg)
                logger.error(f"CRITICAL: Position size exceeds risk limit for {symbol}: {actual_risk_usdt} > {account_balance * 0.25}")
                return

            # Check OKX minimum requirements
            min_size = await self._get_min_position_size(symbol)
            if position_size_coins < min_size:
                # OKX minimum USDT miktarını kontrol et
                min_usdt = await self._get_min_usdt_amount(symbol)

                if position_size_usdt < min_usdt:
                    # Minimum USDT miktarı ile gir
                    original_risk = position_size_usdt
                    position_size_usdt = min_usdt
                    position_size_coins = min_usdt / current_price

                    logger.info(f"Minimum USDT miktarı kullanılıyor: {symbol}")
                    logger.info(f"   Orijinal: ${original_risk:.2f} → Minimum: ${min_usdt:.2f}")
                    logger.info(f"   Risk artışı: %{((min_usdt/original_risk-1)*100):.1f}")

                    # Uyarı gönder
                    warning_msg = "⚠️ %4 risk hesabıyla pozisyon büyüklüğü OKX minimum USDT miktarını karşılamıyor.\n"
                    warning_msg += f"Symbol: {symbol}\n"
                    warning_msg += f"Orijinal: ${original_risk:.2f}\n"
                    warning_msg += f"Minimum USDT: ${min_usdt:.2f}\n"
                    warning_msg += f"Risk artışı: %{((min_usdt/original_risk-1)*100):.1f}\n"
                    warning_msg += "İşlem minimum USDT miktarı ile devam ediyor..."

                    await self._send_telegram_warning(warning_msg)
                else:
                    # Orijinal risk ile devam et
                    logger.info(f"Orijinal risk ile devam ediliyor: {symbol} = ${position_size_usdt:.2f}")

            # Check maximum open positions limit (20 positions + 50% total risk) and duplicate prevention
            if not await self._check_position_limits(symbol, position_size_usdt, action):
                return

            # Calculate dynamic TP/SL based on volatility, trend strength, and news sentiment
            tp_sl_config = await self._calculate_dynamic_tp_sl(symbol, action, signal)

            # TP/SL is mandatory - reject if calculation fails
            if not tp_sl_config or not tp_sl_config.get('stop_loss') or not tp_sl_config.get('take_profit'):
                warning_msg = "⚠️ TP/SL hesaplanamadı! İşlem açılamıyor.\n"
                warning_msg += f"Symbol: {symbol}\n"
                warning_msg += f"Action: {action}\n"
                warning_msg += "Sebep: Teknik analiz verisi yetersiz"

                await self._send_telegram_warning(warning_msg)
                logger.warning(f"TP/SL calculation failed for {symbol}")
                return

            # Execute the trade with TP/SL attached from the start using OKX unified orders
            if action in ['BUY', 'LONG']:
                # Use place_order_with_tp_sl for unified order with TP/SL
                order_result = await okx_client.place_order_with_tp_sl(
                    inst_id=symbol,  # OKX uses inst_id parameter
                    side='buy',
                    td_mode='cross',
                    ord_type='market',  # Use standard CCXT type
                    sz=str(position_size_coins),
                    tp_trigger_px=str(tp_sl_config['take_profit']),
                    tp_ord_px=str(tp_sl_config['take_profit']),
                    sl_trigger_px=str(tp_sl_config['stop_loss']),
                    sl_ord_px=str(tp_sl_config['stop_loss']),
                    cl_ord_id=f"{symbol[:3]}{int(time.time())}"
                )

                if order_result.get("status") == "success":
                    logger.info(f"✅ Long order with TP/SL placed for {symbol}: {order_result.get('order_id')}")

                    # Create order object for notification
                    order = {
                        'id': order_result.get('order_id'),
                        'symbol': symbol,
                        'side': 'buy',
                        'type': 'market',
                        'amount': position_size_coins,
                        'price': current_price
                    }

                    # Check if fallback was applied and place separate TP orders if needed
                    if order_result.get("fallback_applied"):
                        logger.info(f"🔄 Fallback applied for {symbol} - placing separate TP orders")
                        await self._place_separate_tp_orders(symbol, 'LONG', position_size_coins, tp_sl_config, order_result)

                    # Send detailed notification with TP/SL and leverage
                    await self.notify_trade_opened_detailed(symbol, 'LONG', order, signal, tp_sl_config, position_size_coins, position_size_usdt, dynamic_leverage)
                else:
                    logger.error(f"❌ Long order failed for {symbol}: {order_result}")

            elif action in ['SELL', 'SHORT']:
                # Use place_order_with_tp_sl for unified order with TP/SL
                order_result = await okx_client.place_order_with_tp_sl(
                    inst_id=symbol,  # OKX uses inst_id parameter
                    side='sell',
                    td_mode='cross',
                    ord_type='market',  # Use standard CCXT type
                    sz=str(position_size_coins),
                    tp_trigger_px=str(tp_sl_config['take_profit']),
                    tp_ord_px=str(tp_sl_config['take_profit']),
                    sl_trigger_px=str(tp_sl_config['stop_loss']),
                    sl_ord_px=str(tp_sl_config['stop_loss']),
                    cl_ord_id=f"{symbol[:3]}{int(time.time())}"
                )

                if order_result.get("status") == "success":
                    logger.info(f"✅ Short order with TP/SL placed for {symbol}: {order_result.get('order_id')}")

                    # Create order object for notification
                    order = {
                        'id': order_result.get('order_id'),
                        'symbol': symbol,
                        'side': 'sell',
                        'type': 'market',
                        'amount': position_size_coins,
                        'price': current_price
                    }

                    # Check if fallback was applied and place separate TP orders if needed
                    if order_result.get("fallback_applied"):
                        logger.info(f"🔄 Fallback applied for {symbol} - placing separate TP orders")
                        await self._place_separate_tp_orders(symbol, 'SHORT', position_size_coins, tp_sl_config, order_result)

                    # Send detailed notification with TP/SL and leverage
                    await self.notify_trade_opened_detailed(symbol, 'SHORT', order, signal, tp_sl_config, position_size_coins, position_size_usdt, dynamic_leverage)
                else:
                    logger.error(f"❌ Short order failed for {symbol}: {order_result}")

        except Exception as e:
            logger.error(f"Failed to execute trade signal for {symbol}: {e}")

    async def _place_separate_tp_orders(
        self,
        symbol: str,
        direction: str,
        position_size_coins: float,
        tp_sl_config: dict,
        order_result: dict
    ):
        """
        Place separate TP orders when fallback is applied.
        This happens when TP/SL cannot be attached to the main order due to validation rules.
        """
        try:
            logger.info(f"🔄 Placing separate TP orders for {symbol} {direction}")

            # Determine which orders need to be placed separately
            tp_needed = not order_result.get("tp_attach", True)
            sl_needed = not order_result.get("sl_attach", True)

            if not tp_needed and not sl_needed:
                logger.info(f"✅ No separate orders needed for {symbol}")
                return

            # Get current price for reference
            current_price = await self._get_current_price(symbol)
            if not current_price:
                logger.error(f"❌ Cannot get current price for {symbol} - skipping separate orders")
                return

            # Place separate TP order if needed
            if tp_needed and tp_sl_config.get('take_profit'):
                tp_side = 'sell' if direction == 'LONG' else 'buy'
                tp_result = okx_client.place_separate_tp_order(
                    inst_id=symbol,
                    side=tp_side,
                    td_mode='cross',
                    sz=str(position_size_coins),
                    tp_trigger_px=str(tp_sl_config['take_profit']),
                    tp_ord_px=str(tp_sl_config['take_profit']),
                    cl_ord_id=f"{symbol[:3]}_TP_{int(time.time())}",
                    pos_side=direction.lower()
                )

                if tp_result.get("status") == "success":
                    logger.info(f"✅ Separate TP order placed for {symbol}: {tp_result.get('order_id')}")
                else:
                    logger.error(f"❌ Separate TP order failed for {symbol}: {tp_result}")

            # Place separate SL order if needed
            if sl_needed and tp_sl_config.get('stop_loss'):
                sl_side = 'sell' if direction == 'LONG' else 'buy'
                sl_result = okx_client.place_separate_tp_order(
                    inst_id=symbol,
                    side=sl_side,
                    td_mode='cross',
                    sz=str(position_size_coins),
                    tp_trigger_px=str(tp_sl_config['stop_loss']),
                    tp_ord_px=str(tp_sl_config['stop_loss']),
                    cl_ord_id=f"{symbol[:3]}_SL_{int(time.time())}",
                    pos_side=direction.lower()
                )

                if sl_result.get("status") == "success":
                    logger.info(f"✅ Separate SL order placed for {symbol}: {sl_result.get('order_id')}")
                else:
                    logger.error(f"❌ Separate SL order failed for {symbol}: {sl_result}")

            logger.info(f"🔄 Separate order placement completed for {symbol}")

        except Exception as e:
            logger.error(f"❌ Failed to place separate TP orders for {symbol}: {e}")

    async def _get_account_balance(self) -> float:
        """Get current account balance in USDT."""
        try:
            balance = await okx_client.fetch_balance()
            logger.debug(f"Raw balance data: {balance}")

            # Try different balance formats
            usdt_balance = 0

            # Method 1: Direct USDT key
            if 'USDT' in balance:
                usdt_balance = balance['USDT'].get('total', 0)
                logger.debug(f"USDT balance from direct key: {usdt_balance}")

            # Method 2: From total dict
            elif 'total' in balance and 'USDT' in balance['total']:
                usdt_balance = balance['total']['USDT']
                logger.debug(f"USDT balance from total dict: {usdt_balance}")

            # Method 3: From free dict
            elif 'free' in balance and 'USDT' in balance['free']:
                usdt_balance = balance['free']['USDT']
                logger.debug(f"USDT balance from free dict: {usdt_balance}")

            # Safety check: balance should be reasonable
            if usdt_balance <= 0 or usdt_balance > 1000000:  # 0 to 1M USDT
                logger.error(f"Invalid balance value: {usdt_balance}")
                return 1000  # Safe fallback

            logger.info(f"Final USDT balance: {usdt_balance}")
            return float(usdt_balance)

        except Exception as e:
            logger.error(f"Failed to get account balance: {e}")
            return 1000  # Default fallback

    async def _get_current_price(self, symbol: str) -> float:
        """Get current price for a symbol."""
        try:
            ticker = await okx_client.get_ticker(symbol)
            return ticker.get('last', 0)
        except Exception as e:
            logger.error(f"Failed to get current price for {symbol}: {e}")
            return 0

    async def _get_min_position_size(self, symbol: str) -> float:
        """Get minimum position size for a symbol on OKX."""
        # OKX minimum requirements (simplified)
        min_sizes = {
            'BTC': 0.001, 'ETH': 0.01, 'XRP': 1.0, 'SOL': 0.1, 'ADA': 1.0,
            'CFX': 1.0, 'BIO': 1.0, 'PENGU': 1.0, 'CRO': 1.0, 'LDO': 0.1,
            'TAO': 0.1, 'ARB': 0.1, 'SUI': 0.1, 'AVAX': 0.1, 'UNI': 0.1,
            'RNDR': 0.1, 'FET': 1.0, 'JUP': 1.0, 'OP': 0.1, 'NEAR': 0.1
        }
        return min_sizes.get(symbol, 0.1)

    async def _get_min_usdt_amount(self, symbol: str) -> float:
        """Get minimum USDT amount for a symbol from OKX API."""
        try:
            # Get instrument info from cache or API
            instrument_info = await okx_client.get_instrument(symbol)
            if instrument_info and 'minSz' in instrument_info:
                min_amount = instrument_info['minSz']
                logger.info(f"✅ OKX API: {symbol} minimum size: {min_amount}")
                return float(min_amount)

            # Fallback: Safe default
            logger.warning(f"⚠️ No instrument info for {symbol}, using default 0.01")
            return 0.01

        except Exception as e:
            logger.warning(f"Failed to get min USDT amount for {symbol}: {e}")
            return 0.01  # Güvenli fallback

    async def _check_position_limits(self, symbol: str, position_size_usdt: float, action: str) -> bool:
        """Check if new position can be opened based on limits and duplicate prevention."""
        try:
            # Get current open positions
            open_positions = await okx_client.fetch_positions()
            active_positions = [p for p in open_positions if p.get('size', 0) > 0]

            # Check for duplicate positions on same symbol (Option A: Symbol Lock)
            symbol_positions = [p for p in active_positions if p.get('symbol', '').startswith(symbol)]
            if symbol_positions:
                # Check if same direction position exists
                for pos in symbol_positions:
                    pos_side = pos.get('side', 'unknown')
                    if (action == 'LONG' and pos_side == 'buy') or (action == 'SHORT' and pos_side == 'sell'):
                        warning_msg = "🚫 Duplicate Trade Engellendi! Aynı yönde pozisyon zaten açık.\n"
                        warning_msg += f"Symbol: {symbol}\n"
                        warning_msg += f"Yön: {action}\n"
                        warning_msg += f"Mevcut pozisyon: {pos.get('size', 0)} {symbol}\n"
                        warning_msg += "Sebep: Symbol lock (aynı coinde aynı yönde ikinci pozisyon yasak)"

                        await self._send_telegram_warning(warning_msg)
                        logger.info(f"Duplicate trade prevented for {symbol} {action}")
                        return False

                # Option B: Check for opposite direction (close existing, open new)
                for pos in symbol_positions:
                    pos_side = pos.get('side', 'unknown')
                    if (action == 'LONG' and pos_side == 'sell') or (action == 'SHORT' and pos_side == 'buy'):
                        logger.info(f"Opposite direction signal for {symbol}, will close existing position first")
                        break

            # Check position count limit (20)
            if len(active_positions) >= 20:
                warning_msg = "🚫 Limit aşıldı! 20 açık pozisyon sınırı nedeniyle yeni işlem engellendi.\n"
                warning_msg += f"Symbol: {symbol}\n"
                warning_msg += f"Güncel pozisyon sayısı: {len(active_positions)}"
                await self._send_telegram_warning(warning_msg)
                return False

            # Check total risk limit (50%)
            total_risk_usdt = sum([float(p.get('notional', 0)) for p in active_positions])
            account_balance = await self._get_account_balance()
            max_risk_usdt = account_balance * 0.5  # 50% limit

            if total_risk_usdt + position_size_usdt > max_risk_usdt:
                warning_msg = "🚫 Limit aşıldı! %50 toplam risk sınırı nedeniyle yeni işlem engellendi.\n"
                warning_msg += f"Symbol: {symbol}\n"
                warning_msg += f"Güncel risk: {total_risk_usdt:.2f} USDT\n"
                warning_msg += f"Maksimum risk: {max_risk_usdt:.2f} USDT\n"
                warning_msg += f"Yeni pozisyon: {position_size_usdt:.2f} USDT"
                await self._send_telegram_warning(warning_msg)
                return False

            return True

        except Exception as e:
            logger.error(f"Failed to check position limits: {e}")
            return False

    async def _calculate_dynamic_leverage(self, symbol: str, signal: dict) -> int:
        """Calculate dynamic leverage based on volatility and trend strength."""
        try:
            # Get volatility (ATR)
            df = await okx_client.fetch_ohlcv(symbol, '1h', limit=20)
            if df.empty:
                return self.policy.get('trading', {}).get('leverage', {}).get('default', 10)

            # Calculate ATR
            high = df['high'].max()
            low = df['low'].min()
            close = df['close'].iloc[-1]
            atr = (high - low) / close

            # Get trend strength from signal
            trend_strength = abs(signal.get('trend_score', 0))

            # Base leverage
            base_leverage = 10

            # Adjust based on volatility
            if atr > 0.05:  # High volatility
                base_leverage = int(base_leverage * 0.7)  # Lower leverage for high volatility
            elif atr < 0.02:  # Low volatility
                base_leverage = int(base_leverage * 1.3)  # Higher leverage for low volatility

            # Adjust based on trend strength
            if trend_strength > 0.7:  # Strong trend
                base_leverage = int(base_leverage * 1.2)
            elif trend_strength < 0.4:  # Weak trend
                base_leverage = int(base_leverage * 0.8)

            # Ensure within limits
            min_leverage = self.policy.get('trading', {}).get('leverage', {}).get('min', 2)
            max_leverage = self.policy.get('trading', {}).get('leverage', {}).get('max', 20)

            final_leverage = max(min_leverage, min(max_leverage, base_leverage))

            return final_leverage

        except Exception as e:
            logger.error(f"Failed to calculate dynamic leverage: {e}")
            return self.policy.get('trading', {}).get('leverage', {}).get('default', 10)

    async def _calculate_dynamic_tp_sl(self, symbol: str, action: str, signal: dict) -> dict:
        """Calculate dynamic TP/SL based on volatility, trend strength, and news sentiment."""
        try:
            # Get volatility (ATR)
            df = await okx_client.fetch_ohlcv(symbol, '1h', limit=20)
            if df.empty:
                # Get current price for default TP/SL
                current_price = await self._get_current_price(symbol)
                if not current_price:
                    return None
                return self._get_default_tp_sl(action, current_price)

            # Calculate ATR
            high = df['high'].max()
            low = df['low'].min()
            close = df['close'].iloc[-1]
            atr = (high - low) / close

            # Get trend strength from signal
            trend_strength = abs(signal.get('trend_score', 0))

            # Get news sentiment
            news_sentiment = signal.get('news_sentiment', {}).get('sentiment', 'neutral')

            # Base TP/SL ratios
            base_tp_ratio = 2.0  # 2R base
            base_sl_ratio = 1.0  # 1R base

            # Adjust based on volatility
            if atr > 0.05:  # High volatility
                base_tp_ratio *= 1.5
                base_sl_ratio *= 1.2
            elif atr < 0.02:  # Low volatility
                base_tp_ratio *= 0.8
                base_sl_ratio *= 0.8

            # Adjust based on trend strength
            if trend_strength > 0.7:  # Strong trend
                base_tp_ratio *= 1.3
            elif trend_strength < 0.4:  # Weak trend
                base_tp_ratio *= 0.7

            # Adjust based on news sentiment
            if news_sentiment == 'positive':
                base_tp_ratio *= 1.1
            elif news_sentiment == 'negative':
                base_sl_ratio *= 0.9

            # Calculate final TP/SL
            current_price = await self._get_current_price(symbol)
            if not current_price:
                return None

            if action == 'LONG':
                stop_loss = current_price * (1 - base_sl_ratio * 0.01)
                take_profit = current_price * (1 + base_tp_ratio * 0.01)
            else:  # SHORT
                stop_loss = current_price * (1 + base_sl_ratio * 0.01)
                take_profit = current_price * (1 - base_tp_ratio * 0.01)

            rr_ratio = base_tp_ratio / base_sl_ratio

            # Create explanation
            explanation = f"ATR: {atr:.3f} ({'Yüksek' if atr > 0.05 else 'Düşük'} volatilite)\n"
            explanation += f"Trend gücü: {trend_strength:.2f} ({'Güçlü' if trend_strength > 0.7 else 'Zayıf'})\n"
            explanation += f"Haber sentiment: {news_sentiment}\n"
            explanation += f"TP: {base_tp_ratio:.1f}R, SL: {base_sl_ratio:.1f}R"

            return {
                'stop_loss': stop_loss,
                'take_profit': take_profit,
                'rr_ratio': rr_ratio,
                'explanation': explanation
            }

        except Exception as e:
            logger.error(f"Failed to calculate dynamic TP/SL: {e}")
            return self._get_default_tp_sl(action, signal['entry_price'])

    def _get_default_tp_sl(self, action: str, entry_price: float) -> dict:
        """Get default TP/SL if dynamic calculation fails."""
        if action == 'LONG':
            stop_loss = entry_price * 0.98
            take_profit = entry_price * 1.04
        else:  # SHORT
            stop_loss = entry_price * 1.02
            take_profit = entry_price * 0.96

        return {
            'stop_loss': stop_loss,
            'take_profit': take_profit,
            'rr_ratio': 2.0,
            'explanation': 'Varsayılan TP/SL (dinamik hesaplama başarısız)'
        }

    async def _send_telegram_warning(self, message: str):
        """Send warning message to Telegram."""
        try:
            await telegram_client.send_notification(
                "⚠️ Trading Uyarısı",
                message,
                "warning"
            )
        except Exception as e:
            logger.error(f"Failed to send Telegram warning: {e}")

    async def close_high_risk_position(self, symbol: str):
        """Close position that exceeds risk limits."""
        try:
            # Get current positions
            positions = await okx_client.fetch_positions()
            symbol_positions = [p for p in positions if p.get('symbol', '').startswith(symbol)]

            for pos in symbol_positions:
                if pos.get('size', 0) > 0:
                    # Calculate actual risk
                    position_value = float(pos.get('notional', 0))
                    account_balance = await self._get_account_balance()
                    risk_percentage = (position_value / account_balance) * 100

                    if risk_percentage > 25:  # Close if risk > 25% (single position limit)
                        logger.warning(f"Closing high risk position: {symbol} - Risk: %{risk_percentage:.1f}")

                        # Close position
                        close_order = await okx_client.place_order(
                            symbol=symbol,
                            side='sell' if pos.get('side') == 'buy' else 'buy',
                            order_type='market',
                            size=pos.get('size'),
                            params={'tdMode': 'cross'}
                        )

                        if close_order:
                            warning_msg = "🚨 Yüksek Risk Pozisyonu Kapatıldı!\n"
                            warning_msg += f"Symbol: {symbol}\n"
                            warning_msg += f"Risk: %{risk_percentage:.1f}\n"
                            warning_msg += f"Pozisyon değeri: ${position_value:.2f}\n"
                            warning_msg += f"Order ID: {close_order.get('id')}"

                            await self._send_telegram_warning(warning_msg)
                            logger.info(f"High risk position closed for {symbol}")

        except Exception as e:
            logger.error(f"Failed to close high risk position for {symbol}: {e}")

    async def _set_tp_sl_for_order(self, order_id: str, symbol: str, tp_sl_config: dict, direction: str, position_size_coins: float):
        """Set TP/SL for an existing order using OKX API - DEPRECATED: Now using unified orders with TP/SL."""
        try:
            logger.info(f"⚠️ DEPRECATED: _set_tp_sl_for_order called for {symbol} {direction}")
            logger.info("   TP/SL is now set automatically when placing orders")
            logger.info(f"   Stop Loss: ${tp_sl_config.get('stop_loss', 'N/A')}")
            logger.info(f"   Take Profit: ${tp_sl_config.get('take_profit', 'N/A')}")
            logger.info(f"   R/R Ratio: {tp_sl_config.get('rr_ratio', 'N/A')}")

        except Exception as e:
            logger.error(f"Failed to set TP/SL for {symbol} {direction}: {e}")

    async def notify_trade_opened_detailed(self, symbol: str, direction: str, order: dict, signal: dict, tp_sl_config: dict, position_size_coins: float, position_size_usdt: float, dynamic_leverage: int):
        """Send enhanced position opened notification with rich formatting."""
        try:
            # Direction emojis
            direction_emoji = "🟢" if direction == "LONG" else "🔴"
            direction_text = "LONG" if direction == "LONG" else "SHORT"

            # Calculate potential P&L
            entry_price = signal.get('entry_price', 0)
            stop_loss = tp_sl_config.get('stop_loss', 0)
            take_profit = tp_sl_config.get('take_profit', 0)

            # Risk calculation
            risk_per_trade = self.policy.get('trading', {}).get('risk_per_trade_pct', 4.0)

            # Create rich formatted message
            message = f"""
{direction_emoji} **{direction_text} POZİSYONU AÇILDI** {direction_emoji}

📊 **Trading Details:**
   • **Symbol:** `{symbol}`
   • **Direction:** {direction_text}
   • **Entry Price:** ${entry_price:.6f}
   • **Quantity:** {position_size_coins:.6f} {symbol.replace('-USDT-SWAP', '')}
   • **Position Value:** ${position_size_usdt:.2f} USDT
   • **Risk per Trade:** %{risk_per_trade}
   • **Leverage:** {dynamic_leverage}x

🎯 **Risk Management:**
   • **Stop Loss:** ${stop_loss:.6f} ({(abs(entry_price - stop_loss) / entry_price * 100):.2f}%)
   • **Take Profit:** ${take_profit:.6f} ({(abs(take_profit - entry_price) / entry_price * 100):.2f}%)
   • **Risk/Reward:** {tp_sl_config.get('rr_ratio', 0):.2f}

🔍 **Order Information:**
   • **Order ID:** `{order.get('id', 'N/A')}`
   • **Order Type:** Market
   • **TP/SL:** Auto-attached ✅

⏰ **Opened:** {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}
            """.strip()

            # Send enhanced notification
            await telegram_client.send_enhanced_position_opened(
                symbol=symbol,
                direction=direction_text,
                entry_price=entry_price,
                quantity=position_size_coins,
                position_value=position_size_usdt,
                leverage=dynamic_leverage,
                stop_loss=stop_loss,
                take_profit=take_profit,
                rr_ratio=tp_sl_config.get('rr_ratio', 0),
                order_id=order.get('id', 'N/A'),
                risk_per_trade=risk_per_trade
            )

            logger.info(f"✅ Enhanced position opened notification sent for {symbol} {direction}")

        except Exception as e:
            logger.error(f"Failed to send enhanced position notification: {e}")
            # Fallback to simple notification
            try:
                simple_message = f"🟢 {symbol} {direction} POZİSYONU AÇILDI - Entry: ${signal.get('entry_price', 0):.6f}"
                await telegram_client.send_message(simple_message)
            except Exception as fallback_error:
                logger.error(f"Fallback notification also failed: {fallback_error}")

    async def _update_news(self):
        """Update news and sentiment data."""
        try:
            logger.info("Updating news data...")
            news_client = get_client()
            await news_client.fetch_news()
            logger.info("News update completed")
        except Exception as e:
            logger.error(f"News update failed: {e}")


    async def _cleanup(self):
        """Clean up resources."""
        try:
            # Stop scheduler
            await scheduler.stop()

            # Close OKX client
            await okx_client.close()

            # Close Telegram client
            await telegram_client.close()

            # Close news client
            news_client = get_client()
            await news_client.close()

            # Save final state
            await state_store.backup_state()

            logger.info("Cleanup completed")

        except Exception as e:
            logger.error(f"Cleanup failed: {e}")

    def get_status(self) -> dict[str, Any]:
        """Get bot status information."""
        uptime = datetime.now() - self.start_time

        return {
            "running": self.running,
            "uptime": str(uptime),
            "symbols_count": len(self.symbols),
            "symbols": self.symbols,
            "timeframe": self.timeframe,
            "total_signals": self.total_signals,
            "successful_trades": self.successful_trades,
            "last_analysis": {k: v.isoformat() for k, v in self.last_analysis.items()},
            "dry_run": is_dry_run(),
            "paper_trading": is_paper_trading()
        }

    def get_symbols_summary(self) -> str:
        """Get a formatted summary of monitored symbols."""
        if len(self.symbols) <= 10:
            return ", ".join(self.symbols)
        else:
            first_five = ", ".join(self.symbols[:5])
            last_five = ", ".join(self.symbols[-5:])
            return f"{first_five} ... {last_five}"

    async def notify_trade_opened(self, trade_data: dict[str, Any]):
        """Notify when a trade is opened."""
        try:
            await notification_manager.send_trade_opened_notification(trade_data)
        except Exception as e:
            logger.error(f"Failed to notify trade opened: {e}")

    async def notify_trade_closed(self, trade_data: dict[str, Any]):
        """Notify when a trade is closed."""
        try:
            await notification_manager.send_trade_closed_notification(trade_data)
        except Exception as e:
            logger.error(f"Failed to notify trade closed: {e}")


# Global bot instance for external access
_global_bot_instance = None

def get_bot_instance() -> TradingBot | None:
    """Get the global bot instance for external access."""
    return _global_bot_instance

async def main():
    """Main entry point."""
    global _global_bot_instance

    # Configure logging
    logger.add(
        "logs/trading_bot.log",
        rotation="1 day",
        retention="30 days",
        level=settings.log_level,
        format="{time:YYYY-MM-DD HH:mm:ss} | {level} | {message}"
    )

    logger.info("=" * 50)
    logger.info("OKX Trading Bot Starting")
    logger.info("=" * 50)

    # Create and start bot
    bot = TradingBot()
    _global_bot_instance = bot

    try:
        await bot.start()
    except KeyboardInterrupt:
        logger.info("Received keyboard interrupt")
    except Exception as e:
        logger.error(f"Unexpected error: {e}")
    finally:
        await bot.stop()

    logger.info("=" * 50)
    logger.info("OKX Trading Bot Stopped")
    logger.info("=" * 50)


if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        logger.info("\nBot stopped by user")
    except Exception as e:
        logger.info(f"Fatal error: {e}")
        sys.exit(1)
