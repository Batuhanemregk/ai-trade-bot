# AiBotBS Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env files to version control

# =============================================================================
# EXCHANGE CONFIGURATION
# =============================================================================

# OKX Exchange API Configuration
# Get these from your OKX account settings
OKX_API_KEY=your_okx_api_key_here
OKX_API_SECRET=your_okx_api_secret_here
OKX_API_PASSPHRASE=your_okx_passphrase_here

# Exchange settings
EXCHANGE=okx                    # Exchange name (okx, binance, bybit)
MARKET=futures                  # Market type (spot, futures, margin)
TESTNET=false                   # Use testnet (true/false)

# =============================================================================
# TELEGRAM BOT CONFIGURATION
# =============================================================================

# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Chat ID for notifications (get from @userinfobot)
TELEGRAM_CHAT_ID=your_chat_id_here

# Bot settings
TELEGRAM_WEBHOOK_URL=          # Webhook URL (optional, for production)
TELEGRAM_ALLOWED_USERS=        # Comma-separated list of allowed user IDs

# =============================================================================
# AI AND MACHINE LEARNING
# =============================================================================

# OpenAI API (optional, for advanced sentiment analysis)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4             # Model to use (gpt-3.5-turbo, gpt-4)

# Alternative LLM providers
ANTHROPIC_API_KEY=             # Anthropic Claude API key
GOOGLE_AI_API_KEY=             # Google AI API key

# =============================================================================
# RISK MANAGEMENT
# =============================================================================

# Position and risk limits
MAX_POSITION_SIZE=0.1          # Maximum position size (0.0 to 1.0)
MAX_DAILY_LOSS=0.05            # Maximum daily loss (0.0 to 1.0)
MAX_PORTFOLIO_EXPOSURE=0.45    # Maximum portfolio exposure (0.0 to 1.0)

# Stop loss and take profit
STOP_LOSS_ATR_MULT=2.0         # ATR multiplier for stop loss
TAKE_PROFIT_PERCENT=2.0        # Take profit percentage
TRAILING_PERCENT=0.8           # Trailing stop percentage

# Correlation and diversification
CORRELATION_LIMIT=0.7          # Maximum correlation between positions
MIN_DIVERSIFICATION=3           # Minimum number of different assets

# =============================================================================
# TRADING CONFIGURATION
# =============================================================================

# Order execution
DEFAULT_ORDER_TYPE=market       # Default order type (market, limit)
ORDER_TIMEOUT=30               # Order timeout in seconds
MAX_RETRIES=3                  # Maximum retry attempts

# Bracket orders
AUTO_ATTACH_BRACKET=true       # Automatically attach TP/SL orders
BRACKET_TIMEOUT=60             # Bracket order timeout

# Quantization
PRICE_PRECISION=8              # Price precision (decimal places)
SIZE_PRECISION=6               # Size precision (decimal places)
MIN_ORDER_SIZE=0.001           # Minimum order size

# =============================================================================
# SYSTEM CONFIGURATION
# =============================================================================

# Environment
ENVIRONMENT=development         # Environment (development, staging, production)
DEBUG=true                     # Enable debug mode
LOG_LEVEL=INFO                 # Log level (DEBUG, INFO, WARNING, ERROR)

# Dry run mode
DRY_RUN=true                   # Enable dry run (no real trades)
DRY_RUN_BALANCE=10000          # Simulated balance for dry run

# =============================================================================
# PATHS AND DIRECTORIES
# =============================================================================

# State and data directories
AIBOTBS_STATE_DIR=state        # State persistence directory
AIBOTBS_LOG_DIR=logs           # Log files directory
AIBOTBS_CONFIG_DIR=configs     # Configuration files directory
AIBOTBS_DATA_DIR=data          # Data storage directory

# =============================================================================
# SCHEDULER CONFIGURATION
# =============================================================================

# Job scheduling
SCHEDULER_ENABLED=true         # Enable job scheduler
SCHEDULER_MAX_JOBS=50          # Maximum concurrent jobs
SCHEDULER_TIMEOUT=300          # Job timeout in seconds

# Default job intervals
MARKET_OVERVIEW_INTERVAL=900   # Market overview every 15 minutes
HEALTH_CHECK_INTERVAL=300      # Health check every 5 minutes
DATA_CLEANUP_INTERVAL=3600     # Data cleanup every hour

# =============================================================================
# MONITORING AND OBSERVABILITY
# =============================================================================

# Metrics and monitoring
ENABLE_METRICS=true            # Enable Prometheus metrics
METRICS_PORT=9090              # Metrics server port
HEALTH_CHECK_PORT=8080         # Health check server port

# Logging
LOG_FORMAT=json                # Log format (json, text)
LOG_ROTATION=1d                # Log rotation (1d, 1w, 1M)
LOG_RETENTION=30d              # Log retention period

# =============================================================================
# NETWORK AND CONNECTIVITY
# =============================================================================

# API settings
API_TIMEOUT=30                 # API request timeout
API_RETRY_DELAY=1              # Retry delay in seconds
API_MAX_RETRIES=3              # Maximum API retries

# Webhook settings
WEBHOOK_ENABLED=false          # Enable webhook notifications
WEBHOOK_URL=                   # Webhook endpoint URL
WEBHOOK_SECRET=                # Webhook secret for verification

# =============================================================================
# SECURITY AND AUTHENTICATION
# =============================================================================

# API rate limiting
RATE_LIMIT_ENABLED=true        # Enable rate limiting
RATE_LIMIT_REQUESTS=100        # Requests per minute
RATE_LIMIT_WINDOW=60           # Rate limit window in seconds

# Encryption (optional)
ENCRYPTION_KEY=                # Encryption key for sensitive data
ENCRYPT_SENSITIVE_FIELDS=false # Encrypt sensitive configuration fields

# =============================================================================
# DEVELOPMENT AND TESTING
# =============================================================================

# Testing mode
TESTING=false                  # Enable testing mode
TEST_DATABASE_URL=             # Test database URL
TEST_EXCHANGE=test             # Test exchange name

# Mock services
MOCK_EXCHANGE=false            # Use mock exchange
MOCK_NEWS=false                # Use mock news service
MOCK_LLM=false                 # Use mock LLM service

# =============================================================================
# PERFORMANCE AND OPTIMIZATION
# =============================================================================

# Async settings
MAX_CONCURRENT_TASKS=100       # Maximum concurrent async tasks
TASK_TIMEOUT=300               # Task timeout in seconds

# Caching
CACHE_ENABLED=true             # Enable caching
CACHE_TTL=3600                 # Cache TTL in seconds
CACHE_MAX_SIZE=1000            # Maximum cache entries

# Database
DATABASE_URL=                  # Database connection URL
DATABASE_POOL_SIZE=10          # Database connection pool size
DATABASE_TIMEOUT=30            # Database timeout in seconds

# =============================================================================
# NOTIFICATIONS AND ALERTS
# =============================================================================

# Email notifications (optional)
SMTP_ENABLED=false             # Enable SMTP notifications
SMTP_HOST=                     # SMTP server host
SMTP_PORT=587                  # SMTP server port
SMTP_USERNAME=                 # SMTP username
SMTP_PASSWORD=                 # SMTP password
SMTP_FROM_EMAIL=               # From email address
SMTP_TO_EMAILS=                # Comma-separated list of recipient emails

# Slack notifications (optional)
SLACK_ENABLED=false            # Enable Slack notifications
SLACK_WEBHOOK_URL=             # Slack webhook URL
SLACK_CHANNEL=                 # Slack channel name

# Discord notifications (optional)
DISCORD_ENABLED=false          # Enable Discord notifications
DISCORD_WEBHOOK_URL=           # Discord webhook URL

# =============================================================================
# ADVANCED FEATURES
# =============================================================================

# Machine learning
ML_MODEL_PATH=                 # Path to ML model files
ML_PREDICTION_THRESHOLD=0.6    # ML prediction confidence threshold
ML_RETRAIN_INTERVAL=86400      # ML model retraining interval (seconds)

# Backtesting
BACKTEST_ENABLED=false         # Enable backtesting mode
BACKTEST_START_DATE=           # Backtest start date (YYYY-MM-DD)
BACKTEST_END_DATE=             # Backtest end date (YYYY-MM-DD)
BACKTEST_INITIAL_BALANCE=10000 # Initial balance for backtesting

# Paper trading
PAPER_TRADING=false            # Enable paper trading mode
PAPER_TRADING_BALANCE=10000    # Paper trading balance

# =============================================================================
# COMPLIANCE AND REPORTING
# =============================================================================

# Trading journal
TRADING_JOURNAL_ENABLED=true   # Enable trading journal
JOURNAL_EXPORT_FORMAT=csv      # Journal export format (csv, json, xlsx)
JOURNAL_RETENTION_DAYS=365     # Journal retention period

# Regulatory compliance
COMPLIANCE_ENABLED=false       # Enable compliance features
REPORTING_ENABLED=false        # Enable regulatory reporting
AUDIT_LOG_ENABLED=true         # Enable audit logging

# =============================================================================
# DEPLOYMENT AND SCALING
# =============================================================================

# Container settings
DOCKER_ENABLED=false           # Enable Docker mode
KUBERNETES_ENABLED=false       # Enable Kubernetes mode
SCALE_REPLICAS=1               # Number of replicas

# Load balancing
LOAD_BALANCER_ENABLED=false    # Enable load balancing
HEALTH_CHECK_PATH=/health      # Health check endpoint path
READINESS_CHECK_PATH=/ready    # Readiness check endpoint path

# =============================================================================
# LEGACY AND COMPATIBILITY
# =============================================================================

# Legacy settings (for backward compatibility)
LEGACY_MODE=false              # Enable legacy mode
COMPATIBILITY_LEVEL=1.0        # API compatibility level
DEPRECATION_WARNINGS=true      # Show deprecation warnings

# =============================================================================
# NOTES AND COMMENTS
# =============================================================================

# Important notes:
# 1. Never commit .env files to version control
# 2. Use strong, unique API keys
# 3. Rotate keys regularly
# 4. Monitor API usage and rate limits
# 5. Test configuration in development before production
# 6. Use environment-specific configuration files
# 7. Validate all configuration values on startup
# 8. Log configuration loading (without sensitive values)
# 9. Use secrets management in production
# 10. Regular security audits of configuration

# Environment-specific overrides:
# Create .env.development, .env.staging, .env.production for different environments
# Load the appropriate file based on ENVIRONMENT variable
