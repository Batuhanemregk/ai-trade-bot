# AiBotBS Ortam Yapılandırması
# Bu dosyayı .env olarak kopyalayın ve gerçek değerlerinizi doldurun
# .env dosyalarını asla sürüm kontrolüne eklemeyin

# =============================================================================
# BORSA (EXCHANGE) YAPILANDIRMASI
# =============================================================================

# OKX Borsa API Yapılandırması
# Bunları OKX hesap ayarları sayfanızdan alın
OKX_API_KEY=your_okx_api_key_here
OKX_API_SECRET=your_okx_api_secret_here
OKX_API_PASSPHRASE=your_okx_passphrase_here

# Borsa ayarları
EXCHANGE=okx                    # Borsa adı (okx, binance, bybit)
MARKET=futures                  # Piyasa türü (spot, futures, margin)
TESTNET=false                   # Testnet kullan (true/false)

# =============================================================================
# TELEGRAM BOT YAPILANDIRMASI
# =============================================================================

# @BotFather’dan alınan bot token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Bildirimler için sohbet ID’si (@userinfobot ile alınır)
TELEGRAM_CHAT_ID=your_chat_id_here

# Bot ayarları
TELEGRAM_WEBHOOK_URL=          # Webhook URL (opsiyonel, prod için)
TELEGRAM_ALLOWED_USERS=        # İzinli kullanıcı ID’leri (virgülle ayrılmış)

# =============================================================================
# YAPAY ZEKÂ VE MAKİNE ÖĞRENMESİ
# =============================================================================

# OpenAI API (opsiyonel, gelişmiş duygu/sentiment analizi için)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4             # Kullanılacak model (gpt-3.5-turbo, gpt-4)

# Alternatif LLM sağlayıcıları
ANTHROPIC_API_KEY=             # Anthropic Claude API anahtarı
GOOGLE_AI_API_KEY=             # Google AI API anahtarı

# =============================================================================
# RİSK YÖNETİMİ
# =============================================================================

# Pozisyon ve risk limitleri
MAX_POSITION_SIZE=0.1          # Maksimum pozisyon oranı (0.0 - 1.0)
MAX_DAILY_LOSS=0.05            # Günlük maksimum kayıp (0.0 - 1.0)
MAX_PORTFOLIO_EXPOSURE=0.45    # Maksimum portföy maruziyeti (0.0 - 1.0)

# Zarar kes ve kâr al
STOP_LOSS_ATR_MULT=2.0         # Zarar kes için ATR katsayısı
TAKE_PROFIT_PERCENT=2.0        # Kâr al yüzdesi
TRAILING_PERCENT=0.8           # Takip eden stop yüzdesi

# Korelasyon ve çeşitlilik
CORRELATION_LIMIT=0.7          # Pozisyonlar arası maksimum korelasyon
MIN_DIVERSIFICATION=3           # Minimum farklı varlık sayısı

# =============================================================================
# AL-SAT / İŞLEM YAPILANDIRMASI
# =============================================================================

# Emir yürütme
DEFAULT_ORDER_TYPE=market       # Varsayılan emir tipi (market, limit)
ORDER_TIMEOUT=30               # Emir zaman aşımı (saniye)
MAX_RETRIES=3                  # Maksimum tekrar denemesi

# Bracket emirler
AUTO_ATTACH_BRACKET=true       # TP/SL emirlerini otomatik iliştir
BRACKET_TIMEOUT=60             # Bracket emir zaman aşımı (sn)

# Kuantizasyon
PRICE_PRECISION=8              # Fiyat hassasiyeti (ondalık basamak)
SIZE_PRECISION=6               # Miktar hassasiyeti (ondalık basamak)
MIN_ORDER_SIZE=0.001           # Minimum emir miktarı

# =============================================================================
# SİSTEM YAPILANDIRMASI
# =============================================================================

# Ortam
ENVIRONMENT=development         # Ortam (development, staging, production)
DEBUG=true                     # Hata ayıklama modu
LOG_LEVEL=INFO                 # Log seviyesi (DEBUG, INFO, WARNING, ERROR)

# Kuru çalıştırma (dry run)
DRY_RUN=true                   # Gerçek emir gönderme
DRY_RUN_BALANCE=10000          # Kuru çalıştırma bakiyesi

# =============================================================================
# YOLLAR VE DİZİNLER
# =============================================================================

# Durum ve veri dizinleri
AIBOTBS_STATE_DIR=state        # Durum saklama dizini
AIBOTBS_LOG_DIR=logs           # Log dosyaları dizini
AIBOTBS_CONFIG_DIR=configs     # Yapılandırma dosyaları dizini
AIBOTBS_DATA_DIR=data          # Veri depolama dizini

# =============================================================================
# ZAMANLAYICI (SCHEDULER) YAPILANDIRMASI
# =============================================================================

# İş zamanlama
SCHEDULER_ENABLED=true         # Zamanlayıcıyı etkinleştir
SCHEDULER_MAX_JOBS=50          # Eşzamanlı maksimum iş sayısı
SCHEDULER_TIMEOUT=300          # İş zaman aşımı (saniye)

# Varsayılan iş aralıkları
MARKET_OVERVIEW_INTERVAL=900   # 15 dakikada bir piyasa özeti
HEALTH_CHECK_INTERVAL=300      # 5 dakikada bir sağlık kontrolü
DATA_CLEANUP_INTERVAL=3600     # Saatte bir veri temizleme

# =============================================================================
# İZLENEBİLİRLİK VE GÖZLEMLEME
# =============================================================================

# Metrikler ve izleme
ENABLE_METRICS=true            # Prometheus metriklerini etkinleştir
METRICS_PORT=9090              # Metrik sunucusu portu
HEALTH_CHECK_PORT=8080         # Sağlık kontrolü sunucu portu

# Loglama
LOG_FORMAT=json                # Log formatı (json, text)
LOG_ROTATION=1d                # Log döndürme sıklığı (1d, 1w, 1M)
LOG_RETENTION=30d              # Log saklama süresi

# =============================================================================
# AĞ VE BAĞLANTI
# =============================================================================

# API ayarları
API_TIMEOUT=30                 # API istek zaman aşımı (sn)
API_RETRY_DELAY=1              # Tekrar denemeleri arası bekleme (sn)
API_MAX_RETRIES=3              # Maksimum tekrar denemesi

# Webhook ayarları
WEBHOOK_ENABLED=false          # Webhook bildirimlerini etkinleştir
WEBHOOK_URL=                   # Webhook uç noktası
WEBHOOK_SECRET=                # Webhook doğrulama gizli anahtarı

# =============================================================================
# GÜVENLİK VE KİMLİK DOĞRULAMA
# =============================================================================

# API hız limitleme
RATE_LIMIT_ENABLED=true        # Hız limitlemeyi etkinleştir
RATE_LIMIT_REQUESTS=100        # Dakikadaki istek sayısı
RATE_LIMIT_WINDOW=60           # Hız limiti penceresi (sn)

# Şifreleme (opsiyonel)
ENCRYPTION_KEY=                # Hassas veriler için şifreleme anahtarı
ENCRYPT_SENSITIVE_FIELDS=false # Yapılandırmadaki hassas alanları şifrele

# =============================================================================
# GELİŞTİRME VE TEST
# =============================================================================

# Test modu
TESTING=false                  # Test modunu etkinleştir
TEST_DATABASE_URL=             # Test veritabanı URL’si
TEST_EXCHANGE=test             # Test borsa adı

# Sahte servisler
MOCK_EXCHANGE=false            # Sahte borsa kullan
MOCK_NEWS=false                # Sahte haber servisi kullan
MOCK_LLM=false                 # Sahte LLM servisi kullan

# =============================================================================
# PERFORMANS VE OPTİMİZASYON
# =============================================================================

# Asenkron ayarlar
MAX_CONCURRENT_TASKS=100       # Eşzamanlı azami görev sayısı
TASK_TIMEOUT=300               # Görev zaman aşımı (saniye)

# Önbellekleme
CACHE_ENABLED=true             # Önbelleği etkinleştir
CACHE_TTL=3600                 # Önbellek yaşam süresi (sn)
CACHE_MAX_SIZE=1000            # Maksimum önbellek giriş sayısı

# Veritabanı
DATABASE_URL=                  # Veritabanı bağlantı URL’si
DATABASE_POOL_SIZE=10          # Bağlantı havuzu boyutu
DATABASE_TIMEOUT=30            # Veritabanı zaman aşımı (sn)

# =============================================================================
# BİLDİRİMLER VE ALARMLAR
# =============================================================================

# E-posta bildirimleri (opsiyonel)
SMTP_ENABLED=false             # SMTP bildirimlerini etkinleştir
SMTP_HOST=                     # SMTP sunucusu
SMTP_PORT=587                  # SMTP portu
SMTP_USERNAME=                 # SMTP kullanıcı adı
SMTP_PASSWORD=                 # SMTP şifre
SMTP_FROM_EMAIL=               # Gönderen e-posta
SMTP_TO_EMAILS=                # Alıcı e-postalar (virgülle ayrılmış)

# Slack bildirimleri (opsiyonel)
SLACK_ENABLED=false            # Slack bildirimlerini etkinleştir
SLACK_WEBHOOK_URL=             # Slack webhook URL
SLACK_CHANNEL=                 # Slack kanal adı

# Discord bildirimleri (opsiyonel)
DISCORD_ENABLED=false          # Discord bildirimlerini etkinleştir
DISCORD_WEBHOOK_URL=           # Discord webhook URL

# =============================================================================
# GELİŞMİŞ ÖZELLİKLER
# =============================================================================

# Makine öğrenmesi
ML_MODEL_PATH=                 # ML model dosya yolu
ML_PREDICTION_THRESHOLD=0.6    # ML tahmin güven eşiği
ML_RETRAIN_INTERVAL=86400      # ML yeniden eğitim aralığı (sn)

# Geriye dönük test (backtest)
BACKTEST_ENABLED=false         # Backtest modunu etkinleştir
BACKTEST_START_DATE=           # Backtest başlangıç tarihi (YYYY-MM-DD)
BACKTEST_END_DATE=             # Backtest bitiş tarihi (YYYY-MM-DD)
BACKTEST_INITIAL_BALANCE=10000 # Backtest başlangıç bakiyesi

# Kâğıt üzerinde al-sat (paper trading)
PAPER_TRADING=false            # Paper trading modunu etkinleştir
PAPER_TRADING_BALANCE=10000    # Paper trading bakiyesi

# =============================================================================
# UYUM VE RAPORLAMA
# =============================================================================

# İşlem günlüğü
TRADING_JOURNAL_ENABLED=true   # İşlem günlüğünü etkinleştir
JOURNAL_EXPORT_FORMAT=csv      # Günlük dışa aktarma formatı (csv, json, xlsx)
JOURNAL_RETENTION_DAYS=365     # Günlük saklama süresi (gün)

# Regülasyon uyumu
COMPLIANCE_ENABLED=false       # Uyum özelliklerini etkinleştir
REPORTING_ENABLED=false        # Regülasyonel raporlamayı etkinleştir
AUDIT_LOG_ENABLED=true         # Denetim logunu etkinleştir

# =============================================================================
# DAĞITIM VE ÖLÇEKLEME
# =============================================================================

# Konteyner ayarları
DOCKER_ENABLED=false           # Docker modunu etkinleştir
KUBERNETES_ENABLED=false       # Kubernetes modunu etkinleştir
SCALE_REPLICAS=1               # Kopya sayısı

# Yük dengeleme
LOAD_BALANCER_ENABLED=false    # Yük dengelemeyi etkinleştir
HEALTH_CHECK_PATH=/health      # Sağlık kontrolü uç noktası
READINESS_CHECK_PATH=/ready    # Hazırlık kontrolü uç noktası

# =============================================================================
# ESKİ SÜRÜM/GERİYE UYUMLULUK
# =============================================================================

# Eski/legacy ayarlar (geriye uyumluluk için)
LEGACY_MODE=false              # Legacy modu etkinleştir
COMPATIBILITY_LEVEL=1.0        # API uyumluluk seviyesi
DEPRECATION_WARNINGS=true      # Kullanımdan kalkma uyarılarını göster

# =============================================================================
# NOTLAR VE YORUMLAR
# =============================================================================

# Önemli notlar:
# 1. .env dosyalarını asla sürüm kontrolüne eklemeyin
# 2. Güçlü ve benzersiz API anahtarları kullanın
# 3. Anahtarları düzenli olarak döndürün (rotate)
# 4. API kullanımını ve hız limitlerini izleyin
# 5. Üretim öncesi geliştirme ortamında test edin
# 6. Ortama özgü yapılandırma dosyaları kullanın
# 7. Başlangıçta tüm yapılandırma değerlerini doğrulayın
# 8. Yapılandırma yüklenmesini (hassas değerler olmadan) loglayın
# 9. Üretimde gizli yönetimi (secrets management) kullanın
# 10. Düzenli güvenlik denetimleri yapın

# Ortama özgü geçersiz kılmalar:
# .env.development, .env.staging, .env.production dosyalarını oluşturun
# ENVIRONMENT değişkenine göre uygun dosyayı yükleyin
