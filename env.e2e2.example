# E2E Test Environment Configuration
# Copy this file to .env.e2e and fill in your actual values

# =============================================================================
# OKX API Configuration
# =============================================================================
# Get these from your OKX account API management page
# For paper trading, use testnet API keys
# For live trading, use mainnet API keys (BE VERY CAREFUL!)

# OKX API Credentials
OKX_API_KEY=your_okx_api_key_here
OKX_API_SECRET=your_okx_api_secret_here
OKX_API_PASSPHRASE=your_okx_passphrase_here

# OKX Configuration
OKX_SANDBOX=true                    # true for paper trading, false for live
OKX_TESTNET=true                    # true for testnet, false for mainnet
OKX_MODE=paper                      # paper or live

# =============================================================================
# Telegram Configuration
# =============================================================================
# Get these from @BotFather on Telegram

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Telegram Settings
TELEGRAM_ENABLED=true               # Enable/disable Telegram notifications

# =============================================================================
# E2E Test Configuration
# =============================================================================

# Trading Mode
TRADING_MODE=paper                  # paper or live

# Test Symbols (comma-separated) - All available pairs from policy.yaml
SYMBOLS=BTC-USDT-SWAP,ETH-USDT-SWAP,SOL-USDT-SWAP,ADA-USDT-SWAP,DOT-USDT-SWAP,AVAX-USDT-SWAP,LINK-USDT-SWAP,UNI-USDT-SWAP,ATOM-USDT-SWAP,NEAR-USDT-SWAP,ALGO-USDT-SWAP,ICP-USDT-SWAP,XRP-USDT-SWAP,CFX-USDT-SWAP,BIO-USDT-SWAP,PENGU-USDT-SWAP,CRO-USDT-SWAP,LDO-USDT-SWAP,TAO-USDT-SWAP,ARB-USDT-SWAP,SUI-USDT-SWAP,JUP-USDT-SWAP,OP-USDT-SWAP

# Test Timeframes (comma-separated)
TIMEFRAMES=5m,15m,1h

# Test Duration
E2E_RUN_MINUTES=30                  # Test duration in minutes (5-120)

# Test Behavior
E2E_FAIL_FAST=true                  # Stop on first critical error

# =============================================================================
# News and LLM Configuration
# =============================================================================

# News API Configuration
NEWS_VERBOSITY=summary              # summary or full
LLM_VERBOSITY=summary               # summary or full

# News Sources
NEWS_SOURCES=cryptocompare,cryptopanic,coinstats

# =============================================================================
# Monitoring Configuration
# =============================================================================

# Prometheus Metrics
METRICS_URL=http://localhost:8000/metrics
PROM_READY_URL=http://localhost:9090/-/ready
PROM_TARGETS_URL=http://localhost:9090/targets

# Grafana
GRAFANA_HEALTH_URL=http://localhost:3000/api/health

# =============================================================================
# Logging Configuration
# =============================================================================

# Log Levels
LOG_LEVEL=INFO                      # DEBUG, INFO, WARNING, ERROR
LOG_SUMMARY_MODE=line               # line or block

# Log Rotation
LOG_MAX_SIZE=10MB                   # Maximum log file size
LOG_RETENTION_DAYS=30               # Log retention in days

# =============================================================================
# Risk Management Configuration
# =============================================================================

# Position Sizing
MAX_POSITION_SIZE_PCT=0.10          # Maximum 10% per position
MAX_TOTAL_RISK_PCT=0.60             # Maximum 60% total risk
MAX_CONCURRENT_POSITIONS=20         # Maximum 20 positions

# Circuit Breaker
CIRCUIT_BREAKER_LOSS_PCT=0.15       # 15% loss triggers circuit breaker

# =============================================================================
# Signal Gating Configuration
# =============================================================================

# Signal Persistence
PERSISTENCE_BARS=2                  # Signal must persist N bars
MAX_SIGNAL_AGE_BARS=6               # Maximum signal age

# Signal Confirmation
CONFIRMATION_BARS=2                 # Confirmation bars required

# Hysteresis Thresholds
ENTER_LONG_THRESHOLD=60             # Long entry threshold
EXIT_LONG_THRESHOLD=45              # Long exit threshold
ENTER_SHORT_THRESHOLD=40            # Short entry threshold
EXIT_SHORT_THRESHOLD=55             # Short exit threshold

# =============================================================================
# State Machine Configuration
# =============================================================================

# Cooldown Periods
COOLDOWN_BASE_MINUTES=30            # Base cooldown period
COOLDOWN_MAX_MINUTES=240            # Maximum cooldown period

# Position Management
MIN_HOLD_BARS=3                     # Minimum bars before exit
MAX_POSITION_AGE_HOURS=24           # Maximum position age

# =============================================================================
# Scheduler Configuration
# =============================================================================

# Job Scheduling
SCHEDULER_ENABLED=true              # Enable/disable scheduler
SEMAPHORE_LIMIT=2                   # Max concurrent jobs

# Job Timeouts
JOB_TIMEOUT_SECONDS=300             # Job timeout in seconds
RETRY_ATTEMPTS=3                    # Number of retry attempts

# =============================================================================
# Performance Configuration
# =============================================================================

# API Rate Limiting
API_RATE_LIMIT_PER_SECOND=10        # API calls per second
API_BURST_LIMIT=20                  # Burst limit

# Data Processing
BATCH_SIZE=5                        # Symbols per batch
DATA_CACHE_TTL_MINUTES=5            # Data cache TTL

# =============================================================================
# Development Configuration
# =============================================================================

# Debug Settings
DEBUG_MODE=false                    # Enable debug mode
MOCK_EXCHANGE=false                 # Use mock exchange (NOT for E2E)
MOCK_NEWS=false                     # Use mock news (NOT for E2E)

# Feature Flags
ENABLE_ML_SCORING=true              # Enable ML scoring
ENABLE_NEWS_INTEGRATION=true        # Enable news integration
ENABLE_TELEGRAM_BOT=true            # Enable Telegram bot
ENABLE_PERFORMANCE_TRACKING=true    # Enable performance tracking

# =============================================================================
# Security Configuration
# =============================================================================

# API Security
API_TIMEOUT_SECONDS=30              # API timeout
SSL_VERIFY=true                     # Verify SSL certificates

# Data Security
ENCRYPT_SENSITIVE_DATA=false        # Encrypt sensitive data
LOG_SENSITIVE_DATA=false            # Log sensitive data (NEVER true in production)

# =============================================================================
# Backup and Recovery
# =============================================================================

# State Persistence
STATE_PERSIST_PATH=data/runtime_state.json
STATE_BACKUP_INTERVAL_HOURS=1       # State backup interval

# Data Backup
BACKUP_ENABLED=true                 # Enable data backup
BACKUP_INTERVAL_HOURS=6             # Backup interval
BACKUP_RETENTION_DAYS=7             # Backup retention

# =============================================================================
# Notes and Warnings
# =============================================================================

# IMPORTANT SECURITY NOTES:
# 1. NEVER commit this file with real API keys to version control
# 2. Use paper trading mode for testing
# 3. Double-check all settings before running live tests
# 4. Keep your API keys secure and rotate them regularly
# 5. Use environment variables in production

# TESTING NOTES:
# 1. Start with paper trading mode
# 2. Use small test amounts
# 3. Monitor logs carefully
# 4. Test all components before live trading
# 5. Have a stop-loss strategy ready

# MONITORING NOTES:
# 1. Ensure Prometheus and Grafana are running
# 2. Check metrics endpoints are accessible
# 3. Monitor system resources during tests
# 4. Set up alerts for critical conditions
# 5. Keep logs for analysis



