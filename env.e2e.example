# E2E Test Ortam Konfigürasyonu
# Bu dosyayı .env.e2e olarak kopyalayın ve gerçek değerlerinizi girin

# =============================================================================
# OKX API Konfigürasyonu
# =============================================================================
# Bu değerleri OKX hesabınızın API yönetim sayfasından alın
# Paper trading için testnet API anahtarları kullanın
# Canlı trading için mainnet API anahtarları kullanın (ÇOK DİKKATLİ OLUN!)

# OKX API Kimlik Bilgileri
OKX_API_KEY=your_okx_api_key_here
OKX_API_SECRET=your_okx_api_secret_here
OKX_API_PASSPHRASE=your_okx_passphrase_here

# OKX Konfigürasyonu
OKX_SANDBOX=true                    # paper trading için true, canlı için false
OKX_TESTNET=true                    # testnet için true, mainnet için false
OKX_MODE=paper                      # paper veya live

# =============================================================================
# Telegram Konfigürasyonu
# =============================================================================
# Bu değerleri Telegram'da @BotFather'dan alın

# Telegram Bot Konfigürasyonu
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Telegram Ayarları
TELEGRAM_ENABLED=true               # Telegram bildirimlerini aç/kapat

# =============================================================================
# E2E Test Konfigürasyonu
# =============================================================================

# Trading Modu
TRADING_MODE=paper                  # paper veya live

# Test Sembolleri (virgülle ayrılmış) - Policy.yaml'daki tüm mevcut çiftler
SYMBOLS=BTC-USDT-SWAP,ETH-USDT-SWAP,SOL-USDT-SWAP,ADA-USDT-SWAP,DOT-USDT-SWAP,AVAX-USDT-SWAP,LINK-USDT-SWAP,UNI-USDT-SWAP,ATOM-USDT-SWAP,NEAR-USDT-SWAP,ALGO-USDT-SWAP,ICP-USDT-SWAP,XRP-USDT-SWAP,CFX-USDT-SWAP,BIO-USDT-SWAP,PENGU-USDT-SWAP,CRO-USDT-SWAP,LDO-USDT-SWAP,TAO-USDT-SWAP,ARB-USDT-SWAP,SUI-USDT-SWAP,JUP-USDT-SWAP,OP-USDT-SWAP

# Test Zaman Çerçeveleri (virgülle ayrılmış)
TIMEFRAMES=5m,15m,1h

# Test Süresi
E2E_RUN_MINUTES=30                  # Test süresi dakika cinsinden (5-120)

# Test Davranışı
E2E_FAIL_FAST=true                  # İlk kritik hatada dur

# =============================================================================
# Haber ve LLM Konfigürasyonu
# =============================================================================

# Haber API Konfigürasyonu
NEWS_VERBOSITY=summary              # summary veya full
LLM_VERBOSITY=summary               # summary veya full

# Haber Kaynakları
NEWS_SOURCES=cryptocompare,cryptopanic,coinstats

# =============================================================================
# İzleme Konfigürasyonu
# =============================================================================

# Prometheus Metrikleri
METRICS_URL=http://localhost:8000/metrics
PROM_READY_URL=http://localhost:9090/-/ready
PROM_TARGETS_URL=http://localhost:9090/targets

# Grafana
GRAFANA_HEALTH_URL=http://localhost:3000/api/health

# =============================================================================
# Loglama Konfigürasyonu
# =============================================================================

# Log Seviyeleri
LOG_LEVEL=INFO                      # DEBUG, INFO, WARNING, ERROR
LOG_SUMMARY_MODE=line               # line veya block

# Log Rotasyonu
LOG_MAX_SIZE=10MB                   # Maksimum log dosya boyutu
LOG_RETENTION_DAYS=30               # Log saklama süresi gün cinsinden

# =============================================================================
# Risk Yönetimi Konfigürasyonu
# =============================================================================

# Pozisyon Boyutlandırma
MAX_POSITION_SIZE_PCT=0.10          # Pozisyon başına maksimum %10
MAX_TOTAL_RISK_PCT=0.60             # Toplam maksimum %60 risk
MAX_CONCURRENT_POSITIONS=20         # Maksimum 20 pozisyon

# Devre Kesici
CIRCUIT_BREAKER_LOSS_PCT=0.15       # %15 kayıp devre kesiciyi tetikler

# =============================================================================
# Sinyal Gating Konfigürasyonu
# =============================================================================

# Sinyal Kalıcılığı
PERSISTENCE_BARS=2                  # Sinyal N bar boyunca kalmalı
MAX_SIGNAL_AGE_BARS=6               # Maksimum sinyal yaşı

# Sinyal Onayı
CONFIRMATION_BARS=2                 # Gerekli onay bar sayısı

# Histeresis Eşikleri
ENTER_LONG_THRESHOLD=60             # Long giriş eşiği
EXIT_LONG_THRESHOLD=45              # Long çıkış eşiği
ENTER_SHORT_THRESHOLD=40            # Short giriş eşiği
EXIT_SHORT_THRESHOLD=55             # Short çıkış eşiği

# =============================================================================
# Durum Makinesi Konfigürasyonu
# =============================================================================

# Bekleme Süreleri
COOLDOWN_BASE_MINUTES=30            # Temel bekleme süresi
COOLDOWN_MAX_MINUTES=240            # Maksimum bekleme süresi

# Pozisyon Yönetimi
MIN_HOLD_BARS=3                     # Çıkıştan önce minimum bar sayısı
MAX_POSITION_AGE_HOURS=24           # Maksimum pozisyon yaşı

# =============================================================================
# Zamanlayıcı Konfigürasyonu
# =============================================================================

# İş Zamanlama
SCHEDULER_ENABLED=true              # Zamanlayıcıyı aç/kapat
SEMAPHORE_LIMIT=2                   # Maksimum eşzamanlı iş

# İş Zaman Aşımları
JOB_TIMEOUT_SECONDS=300             # İş zaman aşımı saniye cinsinden
RETRY_ATTEMPTS=3                    # Yeniden deneme sayısı

# =============================================================================
# Performans Konfigürasyonu
# =============================================================================

# API Hız Sınırlaması
API_RATE_LIMIT_PER_SECOND=10        # Saniye başına API çağrısı
API_BURST_LIMIT=20                  # Patlama limiti

# Veri İşleme
BATCH_SIZE=5                        # Toplu işlem başına sembol sayısı
DATA_CACHE_TTL_MINUTES=5            # Veri önbellek TTL

# =============================================================================
# Geliştirme Konfigürasyonu
# =============================================================================

# Hata Ayıklama Ayarları
DEBUG_MODE=false                    # Hata ayıklama modunu aç
MOCK_EXCHANGE=false                 # Mock exchange kullan (E2E için DEĞİL)
MOCK_NEWS=false                     # Mock haber kullan (E2E için DEĞİL)

# Özellik Bayrakları
ENABLE_ML_SCORING=true              # ML skorlamayı etkinleştir
ENABLE_NEWS_INTEGRATION=true        # Haber entegrasyonunu etkinleştir
ENABLE_TELEGRAM_BOT=true            # Telegram botunu etkinleştir
ENABLE_PERFORMANCE_TRACKING=true    # Performans takibini etkinleştir

# =============================================================================
# Güvenlik Konfigürasyonu
# =============================================================================

# API Güvenliği
API_TIMEOUT_SECONDS=30              # API zaman aşımı
SSL_VERIFY=true                     # SSL sertifikalarını doğrula

# Veri Güvenliği
ENCRYPT_SENSITIVE_DATA=false        # Hassas verileri şifrele
LOG_SENSITIVE_DATA=false            # Hassas verileri logla (ÜRETİMDE ASLA true YAPMAYIN)

# =============================================================================
# Yedekleme ve Kurtarma
# =============================================================================

# Durum Kalıcılığı
STATE_PERSIST_PATH=data/runtime_state.json
STATE_BACKUP_INTERVAL_HOURS=1       # Durum yedekleme aralığı

# Veri Yedekleme
BACKUP_ENABLED=true                 # Veri yedeklemeyi etkinleştir
BACKUP_INTERVAL_HOURS=6             # Yedekleme aralığı
BACKUP_RETENTION_DAYS=7             # Yedekleme saklama süresi

# =============================================================================
# Notlar ve Uyarılar
# =============================================================================

# ÖNEMLİ GÜVENLİK NOTLARI:
# 1. Bu dosyayı gerçek API anahtarlarıyla versiyon kontrolüne ASLA commit etmeyin
# 2. Test için paper trading modunu kullanın
# 3. Canlı testleri çalıştırmadan önce tüm ayarları iki kez kontrol edin
# 4. API anahtarlarınızı güvende tutun ve düzenli olarak değiştirin
# 5. Üretimde ortam değişkenlerini kullanın

# TEST NOTLARI:
# 1. Paper trading modu ile başlayın
# 2. Küçük test miktarları kullanın
# 3. Logları dikkatli izleyin
# 4. Canlı trading öncesi tüm bileşenleri test edin
# 5. Stop-loss stratejinizi hazır bulundurun

# İZLEME NOTLARI:
# 1. Prometheus ve Grafana'nın çalıştığından emin olun
# 2. Metrik endpoint'lerinin erişilebilir olduğunu kontrol edin
# 3. Test sırasında sistem kaynaklarını izleyin
# 4. Kritik durumlar için uyarılar kurun
# 5. Analiz için logları saklayın