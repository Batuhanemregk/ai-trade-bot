# =============================================================================
# RİSK YÖNETİMİ
# =============================================================================

# Pozisyon ve risk limitleri
MAX_POSITION_SIZE=0.1          # Maksimum pozisyon boyutu (0.0 - 1.0)
MAX_DAILY_LOSS=0.05            # Maksimum günlük kayıp (0.0 - 1.0)
MAX_PORTFOLIO_EXPOSURE=0.45    # Maksimum portföy maruziyeti (0.0 - 1.0)

# Zarar durdur ve kar al
STOP_LOSS_ATR_MULT=2.0         # Zarar durdur için ATR çarpanı
TAKE_PROFIT_PERCENT=2.0        # Kar al yüzdesi
TRAILING_PERCENT=0.8           # İz süren stop yüzdesi

# Korelasyon ve çeşitlendirme
CORRELATION_LIMIT=0.7          # Pozisyonlar arası maksimum korelasyon
MIN_DIVERSIFICATION=3           # Minimum farklı varlık sayısı

# --- E2E'den (aynı bırakıldı) ---
# Risk Yönetimi Yapılandırması
# Pozisyon Boyutlandırma
MAX_POSITION_SIZE_PCT=0.10          # Pozisyon başına maksimum %10
MAX_TOTAL_RISK_PCT=0.60             # Toplam maksimum risk %60
MAX_CONCURRENT_POSITIONS=20         # Eşzamanlı maksimum 20 pozisyon
# Devre Kesici (Circuit Breaker)
CIRCUIT_BREAKER_LOSS_PCT=0.15       # %15 kayıpta devre kesici tetiklenir

# =============================================================================
# TİCARET YAPILANDIRMASI
# =============================================================================

# Emir yürütme
DEFAULT_ORDER_TYPE=market       # Varsayılan emir tipi (market, limit)
ORDER_TIMEOUT=30               # Emir zaman aşımı (saniye)
MAX_RETRIES=3                  # Maksimum yeniden deneme sayısı

# Braket emirleri
AUTO_ATTACH_BRACKET=true       # TP/SL emirlerini otomatik ekle
BRACKET_TIMEOUT=60             # Braket emir zaman aşımı

# Kuantizasyon
PRICE_PRECISION=8              # Fiyat hassasiyeti (ondalık basamak)
SIZE_PRECISION=6               # Miktar hassasiyeti (ondalık basamak)
MIN_ORDER_SIZE=0.001           # Minimum emir büyüklüğü

# --- E2E'den (aynı bırakıldı) ---
# Sinyal Kapılama (Gating) Yapılandırması
# Sinyal Kalıcılığı
PERSISTENCE_BARS=2                  # Sinyal N bar sürmeli
MAX_SIGNAL_AGE_BARS=6               # Maksimum sinyal yaşı
# Sinyal Onayı
CONFIRMATION_BARS=2                 # Gerekli onay bar sayısı
# Histerezis Eşikleri
ENTER_LONG_THRESHOLD=60             # Uzun pozisyon giriş eşiği
EXIT_LONG_THRESHOLD=45              # Uzun pozisyon çıkış eşiği
ENTER_SHORT_THRESHOLD=40            # Kısa pozisyon giriş eşiği
EXIT_SHORT_THRESHOLD=55             # Kısa pozisyon çıkış eşiği

# --- E2E'den (aynı bırakıldı) ---
# Durum Makinesi Yapılandırması
# Soğuma Süreleri
COOLDOWN_BASE_MINUTES=30            # Temel soğuma süresi
COOLDOWN_MAX_MINUTES=240            # Maksimum soğuma süresi
# Pozisyon Yönetimi
MIN_HOLD_BARS=3                     # Çıkıştan önce minimum bar sayısı
MAX_POSITION_AGE_HOURS=24           # Maksimum pozisyon yaşı (saat)

# =============================================================================
# SİSTEM YAPILANDIRMASI
# =============================================================================

# Ortam
ENVIRONMENT=development         # Ortam (development, staging, production)
DEBUG=true                     # Hata ayıklama modu
LOG_LEVEL=INFO                 # Log seviyesi (DEBUG, INFO, WARNING, ERROR)

# Kuru Çalıştırma modu
DRY_RUN=false                   # Gerçek işlem yok (dry run)
DRY_RUN_BALANCE=10000          # Dry run için simüle bakiye

# --- E2E'den (aynı bırakıldı) ---
# Ticaret Modu
TRADING_MODE=paper                  # paper veya live

# =============================================================================
# YOLLAR VE DİZİNLER
# =============================================================================

# Durum ve veri dizinleri
AIBOTBS_STATE_DIR=state        # Durum kalıcılık dizini
AIBOTBS_LOG_DIR=logs           # Log dosyaları dizini
AIBOTBS_CONFIG_DIR=configs     # Yapılandırma dosyaları dizini
AIBOTBS_DATA_DIR=data          # Veri depolama dizini

# --- E2E'den (aynı bırakıldı) ---
# Yedekleme ve Kurtarma
# Durum Kalıcılığı
STATE_PERSIST_PATH=data/runtime_state.json
STATE_BACKUP_INTERVAL_HOURS=1       # Durum yedekleme aralığı
# Veri Yedekleme
BACKUP_ENABLED=true                 # Veri yedeklemeyi etkinleştir
BACKUP_INTERVAL_HOURS=6             # Yedekleme aralığı
BACKUP_RETENTION_DAYS=7             # Yedek saklama günü

# =============================================================================
# ZAMANLAYICI YAPILANDIRMASI
# =============================================================================

# İş zamanlama
SCHEDULER_ENABLED=true         # İş zamanlayıcıyı etkinleştir
SCHEDULER_MAX_JOBS=50          # Eşzamanlı maksimum iş
SCHEDULER_TIMEOUT=300          # İş zaman aşımı (saniye)

# Varsayılan iş aralıkları
MARKET_OVERVIEW_INTERVAL=900   # Piyasa özeti her 15 dakikada bir
HEALTH_CHECK_INTERVAL=300      # Sağlık kontrolü her 5 dakikada bir
DATA_CLEANUP_INTERVAL=3600     # Veri temizliği her saat

# --- E2E'den (aynı bırakıldı) ---
# Zamanlayıcı Yapılandırması
# İş Zamanlama
SEMAPHORE_LIMIT=2                   # Eşzamanlı maksimum iş
# İş Zaman Aşımları
JOB_TIMEOUT_SECONDS=300             # İş zaman aşımı (saniye)
RETRY_ATTEMPTS=3                    # Yeniden deneme sayısı

# =============================================================================
# İZLEME VE GÖZLEMLENEBİLİRLİK
# =============================================================================

# Metrikler ve izleme
ENABLE_METRICS=true            # Prometheus metriklerini etkinleştir
METRICS_PORT=9090              # Metrik sunucu portu
HEALTH_CHECK_PORT=8080         # Sağlık kontrol sunucu portu

# Loglama
LOG_FORMAT=json                # Log formatı (json, text)
LOG_ROTATION=1d                # Log döndürme (1d, 1w, 1M)
LOG_RETENTION=30d              # Log saklama süresi

# --- E2E'den (aynı bırakıldı) ---
# İzleme Yapılandırması
# Prometheus Metrikleri
METRICS_URL=http://localhost:8000/metrics
PROM_READY_URL=http://localhost:9090/-/ready
PROM_TARGETS_URL=http://localhost:9090/targets
# Grafana
GRAFANA_HEALTH_URL=http://localhost:3000/api/health

# =============================================================================
# AĞ VE BAĞLANTI
# =============================================================================

# API ayarları
API_TIMEOUT=30                 # API istek zaman aşımı
API_RETRY_DELAY=1              # Yeniden deneme gecikmesi (s)
API_MAX_RETRIES=3              # Maksimum yeniden deneme

# Webhook ayarları
WEBHOOK_ENABLED=false          # Webhook bildirimlerini etkinleştir
WEBHOOK_URL=                   # Webhook uç nokta URL'si
WEBHOOK_SECRET=                # Doğrulama için webhook sırrı

# --- E2E'den (aynı bırakıldı) ---
# Güvenlik Yapılandırması
# API Güvenliği
API_TIMEOUT_SECONDS=30              # API zaman aşımı
SSL_VERIFY=true                     # SSL sertifikalarını doğrula

# --- E2E'den (aynı bırakıldı) ---
# Performans Yapılandırması
# API Oran Sınırları
API_RATE_LIMIT_PER_SECOND=10        # Saniyede API çağrısı
API_BURST_LIMIT=20                  # Patlama limiti
# Veri İşleme
BATCH_SIZE=5                        # Parti başına sembol sayısı
DATA_CACHE_TTL_MINUTES=5            # Veri önbellek TTL

# =============================================================================
# GÜVENLİK VE KİMLİK DOĞRULAMA
# =============================================================================

# API oran sınırlama
RATE_LIMIT_ENABLED=true        # Oran sınırlamayı etkinleştir
RATE_LIMIT_REQUESTS=100        # Dakikadaki istek sayısı
RATE_LIMIT_WINDOW=60           # Oran sınırlama penceresi (saniye)

# Şifreleme (opsiyonel)
ENCRYPTION_KEY=                # Hassas veriler için şifreleme anahtarı
ENCRYPT_SENSITIVE_FIELDS=false # Hassas yapılandırma alanlarını şifrele

# --- E2E'den (aynı bırakıldı) ---
# Veri Güvenliği
ENCRYPT_SENSITIVE_DATA=false        # Hassas verileri şifrele
LOG_SENSITIVE_DATA=false            # Hassas verileri logla (prod'da ASLA true olmasın)

# =============================================================================
# GELİŞTİRME VE TEST
# =============================================================================

# Test modu
TESTING=false                  # Test modunu etkinleştir
TEST_DATABASE_URL=             # Test veritabanı URL'si
TEST_EXCHANGE=test             # Test borsa adı

# Sahte servisler
MOCK_EXCHANGE=false            # Sahte borsa kullan
MOCK_NEWS=false                # Sahte haber servisi
MOCK_LLM=false                 # Sahte LLM servisi

# --- E2E'den (aynı bırakıldı) ---
# Geliştirme Yapılandırması
# Debug Ayarları
DEBUG_MODE=false                    # Hata ayıklamayı etkinleştir
MOCK_EXCHANGE=false                 # Sahte borsa kullan (E2E için DEĞİL)
MOCK_NEWS=false                     # Sahte haber kullan (E2E için DEĞİL)

# Özellik Bayrakları
ENABLE_ML_SCORING=true              # ML skorlamayı etkinleştir
ENABLE_NEWS_INTEGRATION=true        # Haber entegrasyonunu etkinleştir
ENABLE_TELEGRAM_BOT=true            # Telegram botunu etkinleştir
ENABLE_PERFORMANCE_TRACKING=true    # Performans takibini etkinleştir

# =============================================================================
# PERFORMANS VE OPTİMİZASYON
# =============================================================================

# Async ayarları
MAX_CONCURRENT_TASKS=100       # Maksimum eşzamanlı async görev
TASK_TIMEOUT=300               # Görev zaman aşımı (saniye)

# Önbellekleme
CACHE_ENABLED=true             # Önbelleği etkinleştir
CACHE_TTL=3600                 # Önbellek TTL (saniye)
CACHE_MAX_SIZE=1000            # Maksimum önbellek girişi

# Veritabanı
DATABASE_URL=                  # Veritabanı bağlantı URL'si
DATABASE_POOL_SIZE=10          # Bağlantı havuzu boyutu
DATABASE_TIMEOUT=30            # Veritabanı zaman aşımı (saniye)

# =============================================================================
# BİLDİRİMLER VE UYARILAR
# =============================================================================

# E-posta bildirimleri (opsiyonel)
SMTP_ENABLED=false             # SMTP bildirimlerini etkinleştir
SMTP_HOST=                     # SMTP sunucu adresi
SMTP_PORT=587                  # SMTP sunucu portu
SMTP_USERNAME=                 # SMTP kullanıcı adı
SMTP_PASSWORD=                 # SMTP şifresi
SMTP_FROM_EMAIL=               # Gönderen e-posta adresi
SMTP_TO_EMAILS=                # Alıcı e-postalar (virgülle ayrılmış)

# Slack bildirimleri (opsiyonel)
SLACK_ENABLED=false            # Slack bildirimlerini etkinleştir
SLACK_WEBHOOK_URL=             # Slack webhook URL
SLACK_CHANNEL=                 # Slack kanal adı

# Discord bildirimleri (opsiyonel)
DISCORD_ENABLED=false          # Discord bildirimlerini etkinleştir
DISCORD_WEBHOOK_URL=           # Discord webhook URL

# =============================================================================
# GELİŞMİŞ ÖZELLİKLER
# =============================================================================

# Makine öğrenmesi
ML_MODEL_PATH=                 # ML model dosyalarının yolu
ML_PREDICTION_THRESHOLD=0.6    # ML tahmin güven eşiği
ML_RETRAIN_INTERVAL=86400      # ML yeniden eğitim aralığı (saniye)

# Geriye Dönük Test (Backtesting)
BACKTEST_ENABLED=false         # Backtesting modunu etkinleştir
BACKTEST_START_DATE=           # Backtest başlangıç tarihi (YYYY-MM-DD)
BACKTEST_END_DATE=             # Backtest bitiş tarihi (YYYY-MM-DD)
BACKTEST_INITIAL_BALANCE=10000 # Backtest başlangıç bakiyesi

# Kağıt ticaret
PAPER_TRADING=false            # Kağıt ticareti etkinleştir
PAPER_TRADING_BALANCE=10000    # Kağıt ticaret bakiyesi

# --- E2E'den (aynı bırakıldı) ---
# Uçtan Uca (E2E) Test Yapılandırması
# Test Sembolleri (virgülle ayrılmış)
SYMBOLS=BTC-USDT-SWAP,ETH-USDT-SWAP,SOL-USDT-SWAP,ADA-USDT-SWAP,DOT-USDT-SWAP,AVAX-USDT-SWAP,LINK-USDT-SWAP,UNI-USDT-SWAP,ATOM-USDT-SWAP,NEAR-USDT-SWAP,ALGO-USDT-SWAP,ICP-USDT-SWAP,XRP-USDT-SWAP,CFX-USDT-SWAP,BIO-USDT-SWAP,PENGU-USDT-SWAP,CRO-USDT-SWAP,LDO-USDT-SWAP,TAO-USDT-SWAP,ARB-USDT-SWAP,SUI-USDT-SWAP,JUP-USDT-SWAP,OP-USDT-SWAP
# Test Zaman Dilimleri (virgülle ayrılmış)
TIMEFRAMES=5m,15m,1h
# Test Süresi
E2E_RUN_MINUTES=30                  # Test süresi dakika (5-120)
# Test Davranışı
E2E_FAIL_FAST=true                  # İlk kritik hatada durdur

# =============================================================================
# UYUM (COMPLIANCE) VE RAPORLAMA
# =============================================================================

# İşlem günlüğü
TRADING_JOURNAL_ENABLED=true   # İşlem günlüğünü etkinleştir
JOURNAL_EXPORT_FORMAT=csv      # Günlük dışa aktarım formatı (csv, json, xlsx)
JOURNAL_RETENTION_DAYS=365     # Günlük saklama süresi (gün)

# Düzenleyici uyum
COMPLIANCE_ENABLED=false       # Uyum özelliklerini etkinleştir
REPORTING_ENABLED=false        # Düzenleyici raporlamayı etkinleştir
AUDIT_LOG_ENABLED=true         # Denetim loglamasını etkinleştir

# =============================================================================
# DAĞITIM VE ÖLÇEKLEME
# =============================================================================

# Konteyner ayarları
DOCKER_ENABLED=false           # Docker modunu etkinleştir
KUBERNETES_ENABLED=false       # Kubernetes modunu etkinleştir
SCALE_REPLICAS=1               # Kopya sayısı

# Yük dengeleme
LOAD_BALANCER_ENABLED=false    # Yük dengelemeyi etkinleştir
HEALTH_CHECK_PATH=/health      # Sağlık kontrol uç noktası
READINESS_CHECK_PATH=/ready    # Hazır olma kontrol uç noktası

# =============================================================================
# ESKİ/GERİYE DÖNÜK UYUMLULUK
# =============================================================================

# Eski ayarlar (geri uyumluluk için)
LEGACY_MODE=false              # Eski modu etkinleştir
COMPATIBILITY_LEVEL=1.0        # API uyumluluk seviyesi
DEPRECATION_WARNINGS=true      # Kullanımdan kalkma uyarılarını göster

# =============================================================================
# NOTLAR VE AÇIKLAMALAR
# =============================================================================

# Önemli notlar:
# 1. .env dosyalarını asla gerçek anahtarlarla sürüm kontrolüne koymayın
# 2. Güçlü ve benzersiz API anahtarları kullanın
# 3. Anahtarları düzenli olarak döndürün
# 4. API kullanımı ve oran limitlerini izleyin
# 5. Üretime geçmeden önce geliştirmede test edin
# 6. Ortama özel yapılandırma dosyaları kullanın
# 7. Başlangıçta tüm yapılandırma değerlerini doğrulayın
# 8. Yapılandırma yüklemeyi (hassas değerler olmadan) loglayın
# 9. Üretimde gizli yönetimi (secrets management) kullanın
# 10. Düzenli güvenlik denetimleri yapın

# Ortama özel geçersiz kılmalar:
# development, staging, production için .env.development, .env.staging, .env.production oluşturun
# ENVIRONMENT değişkenine göre uygun dosyayı yükleyin

# --- E2E'den (aynı bırakıldı) ---
# NOTLAR ve UYARILAR (E2E)
# ÖNEMLİ GÜVENLİK NOTLARI:
# 1. Bu dosyayı gerçek API anahtarlarıyla asla sürüm kontrolüne eklemeyin
# 2. Testler için kağıt ticaret modunu kullanın
# 3. Canlı testlerden önce tüm ayarları iki kez kontrol edin
# 4. API anahtarlarınızı güvende tutun ve düzenli döndürün
# 5. Üretimde ortam değişkenleri kullanın
# TEST NOTLARI:
# 1. Kağıt ticaret modu ile başlayın
# 2. Küçük test miktarları kullanın
# 3. Logları dikkatle izleyin
# 4. Canlıya almadan önce tüm bileşenleri test edin
# 5. Hazır bir zarar kesme stratejiniz olsun
# İZLEME NOTLARI:
# 1. Prometheus ve Grafana'nın çalıştığından emin olun
# 2. Metrik uç noktalarının erişilebilirliğini kontrol edin
# 3. Testlerde sistem kaynaklarını izleyin
# 4. Kritik durumlar için alarmlar kurun
# 5. Analiz için logları saklayın
